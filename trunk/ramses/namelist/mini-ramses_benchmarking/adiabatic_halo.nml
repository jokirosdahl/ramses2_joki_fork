&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
nrestart=0
nremap=1
nsubcycle=1,1,1,1,2,2
ncontrol=1
verbose=.false.
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='level_007'
initfile(2)='level_008'
initfile(3)='level_009'
initfile(4)='level_010'
/



&OUTPUT_PARAMS
foutput=500
delta_aout=0.1
aend=1.0
/

&AMR_PARAMS
levelmin=7
levelmax=20
nexpand=5,5,1,1
ngridmax=1000000
npartmax=2000000
/

&REFINE_PARAMS
m_refine=12*8.,
ivar_refine=6
var_cut_refine=1e-3
mass_cut_refine=1.00832e-09
interpol_var=1
interpol_type=0
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=1
scheme='muscl'
riemann='hllc'
pressure_fix=.true.
/

&POISSON_PARAMS
epsilon=1.d-4
/
