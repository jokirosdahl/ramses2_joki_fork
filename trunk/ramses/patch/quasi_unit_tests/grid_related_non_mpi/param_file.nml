&RUN_PARAMS 
hydro=.true.
pic=.true.
poisson=.true.
ncontrol=1
nsubcycle=1,1,2,2,2,2
nremap=16
nrestart=0
verbose=.false.
/

&AMR_PARAMS 
levelmin=4
levelmax=9
nparttot=100000
ngridtot=100000
nexpand=1,1,1,1,1,1
boxlen=1.0
/

&INIT_PARAMS
/

&BOUNDARY_PARAMS
nboundary = 6
bound_type= 2, 2, 2, 2, 2, 2
ibound_min=-1,+1,-1,-1,-1,-1
ibound_max=-1,+1,+1,+1,+1,+1
jbound_min= 0, 0,-1,+1,-1,-1
jbound_max= 0, 0,-1,+1,+1,+1
kbound_min= 0, 0, 0, 0,-1,+1
kbound_max= 0, 0, 0, 0,-1,+1
/

&OUTPUT_PARAMS
tend=0.8580683465971367
delta_tout=0.017161366931942734
/

&HYDRO_PARAMS
riemann='hllc'
gamma=1.666666666
courant_factor=0.8
scheme='muscl'
slope_type=2
pressure_fix=.true.
/


&REFINE_PARAMS
jeans_refine=2,2,2,2,2,2,2,2,2
interpol_var=2
interpol_type=2
/

