!> Device-resident DM particle arrays.
module gpu_part_state
  use amr_parameters, only: ndim, twotondim, threetondim, dp, i8b
  use cudafor
  implicit none

  real(kind=dp),   device, allocatable, dimension(:,:) :: xp, vp
  real(kind=dp),   device, allocatable, dimension(:)   :: mp, phip
  integer(kind=4), device, allocatable, dimension(:)   :: levelp
  integer(kind=4), device, allocatable, dimension(:)   :: sortp
  integer(i8b),    device, allocatable, dimension(:)   :: idp

!!$  real(kind=dp),   device, allocatable, dimension(:,:) :: jp
!!$  real(kind=dp),   device, allocatable, dimension(:)   :: zp, tp, tm, size_p, charge
!!$  integer(i8b),    device, allocatable, dimension(:)   :: idm
!!$  integer(kind=4), device, allocatable, dimension(:)   :: idt

  !> xp_swap/isp_swap/idp_swap: gather/scatter scratch with disjoint lifetimes.
  !> isp_swap carries the split-sort bucket / swap-permutation during
  !> gpu_split_part and the packed per-particle source map during
  !> gpu_cic_part. The source-map encoding packs (igrid, icell) into one
  !> 32-bit word: bits 0..4 = icell (1..twotondim), bits 5..31 = igrid.
  !> Encoded as
  !>   isp_swap(ipart) = ior(ishft(igrid, 5), icell)
  !> and decoded as
  !>   combined = isp_swap(ipart)
  !>   icell = iand(combined, 31); igrid = ishft(combined, -5)
  !> OOD sentinel is the whole word == 0 (cheap check before unpacking).
  real(kind=dp),   device, allocatable, dimension(:) :: xp_swap
  integer(kind=8), device, allocatable, dimension(:) :: idp_swap
  integer(kind=4), device, allocatable, dimension(:) :: isp_swap

end module gpu_part_state
