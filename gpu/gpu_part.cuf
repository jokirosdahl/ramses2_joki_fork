!> DM particle CUDA kernels.
module part_device
  use amr_parameters, only: ndim, twotondim, threetondim, dp, i8b, MAXLEVEL
  use oct_commons, only: oct
  use gpu_utils
  use cudafor
  use gpu_part_state, only: &
       xp, vp, mp, levelp, sortp, idp, &
       jp, zp, tp, tm, size_p, charge, idm, idt, &
       hkey_part, bucket_part, &
       cell_part_count, cell_part_head, cell_part_idx, &
       src_part, &
       multipole_q_dev, &
       xp_swap, idp_swap, &
       dtnew_part, dtold_part
  use gpu_runner, only: &
       grid, hash_key, hash_val, ckey_max, key_off, &
       box_ckey_min, box_ckey_max, box_size, periodic, &
       rho, nref, f, &
       swap_local, swap_global, prefix_sum, &
       partial_sums_0, partial_sums_1, partial_sums_2, &
       gpu_scan
  implicit none

  ! Local hash/hilbert/reduce includes.
  private :: mix64, fnv64, fnv32, hash_set, hash_get, hash_update, hash_free
  private :: hilbert_key
  private :: warp_reduce_int_sum, block_reduce_int_sum
  private :: warp_reduce_sum,     block_reduce_sum
  private :: warp_reduce_min,     block_reduce_min
  private :: warp_reduce_max,     block_reduce_max

contains

  include 'gpu_hash.cuf'
  include 'gpu_hilbert.cuf'
  include 'gpu_reduce.cuf'

!> Domain-test partition for the levelmin-1 boundary range.
attributes(global) subroutine bucket_part_boundary(xp, bucket_part, &
     box_size_d, periodic_d, head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp), device :: xp(*)
  integer(kind=4), device :: bucket_part(*)
  real(kind=8), device :: box_size_d(1:3)
  logical, device :: periodic_d(1:3)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart, idim
  logical :: in_domain
  real(kind=8) :: x_idim

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  in_domain = .true.
  do idim = 1, ndim
     if (.not. periodic_d(idim)) then
        x_idim = xp(ipart + (idim-1)*leading)
        if (x_idim < 0d0 .or. x_idim >= box_size_d(idim)) in_domain = .false.
     endif
  end do

  if (in_domain) then
     bucket_part(ipart) = 1
  else
     bucket_part(ipart) = 0
  endif
end subroutine bucket_part_boundary

!> Bucket 0/1 from hash lookup and leaf/refined test.
attributes(global) subroutine bucket_part_general(xp, bucket_part, &
     grid, hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp), device :: xp(*)
  integer(kind=4), device :: bucket_part(*)
  type(oct), device :: grid(*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3
  real(kind=8), intent(in), value :: dx_loc
  integer(kind=4), intent(in), value :: ilevel
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart, idim, igrid, icell
  integer(kind=4) :: ix(1:3), ii(1:3)
  integer(kind=8) :: ix8, iy8, iz8, nx, offset, key
  real(kind=8) :: skip(1:3), x(1:3), xs, inv_dx_loc, inv_2dx_loc

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3
  inv_dx_loc  = 1d0 / dx_loc
  inv_2dx_loc = 0.5d0 * inv_dx_loc

  ix = 0
  do idim = 1, ndim
     xs = xp(ipart + (idim-1)*leading) + skip(idim)
     ix(idim) = floor(xs * inv_2dx_loc)
  end do

  ix8 = int(ix(1), kind=8)
  iy8 = int(ix(2), kind=8)
  iz8 = int(ix(3), kind=8)
  nx  = int(ckey_max_d(ilevel), kind=8)
  offset = key_off_d(ilevel)
  key = offset + ix8 + iy8*nx + iz8*nx*nx

  igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

  if (igrid == 0) then
     bucket_part(ipart) = 0
     return
  endif

  do idim = 1, ndim
     x(idim) = (xp(ipart + (idim-1)*leading) + skip(idim)) * inv_dx_loc
     ii(idim) = int(x(idim) - 2*ix(idim))
  end do
  icell = 1
  do idim = 1, ndim
     icell = icell + ii(idim) * (2**(idim-1))
  end do

  if (.not. grid(igrid)%refined(icell)) then
     bucket_part(ipart) = 0
  else
     bucket_part(ipart) = 1
  endif
end subroutine bucket_part_general

attributes(global) subroutine init_prefix_sum_part(bucket_part, prefix_sum_d, &
     head_idx, num_parts)
  integer(kind=4), device :: bucket_part(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  prefix_sum_d(idx) = bucket_part(idx)
end subroutine init_prefix_sum_part

!> prefix_sum of bucket_part(sortp); last value is n_fine.
attributes(global) subroutine init_prefix_sum_part_hilbert_fine( &
     bucket_part_d, sortp_d, prefix_sum_d, head_idx, num_parts)
  integer(kind=4), device :: bucket_part_d(*)
  integer(kind=4), device :: sortp_d(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  ipart = sortp_d(idx)
  prefix_sum_d(idx) = bucket_part_d(ipart)
end subroutine init_prefix_sum_part_hilbert_fine

!> Hilbert coarse/fine partition into swap_global (one writer per slot).
attributes(global) subroutine write_swap_global_hilbert_partition( &
     swap_global_d, bucket_part_d, sortp_d, prefix_sum_d, &
     head_idx, num_parts, n_coarse)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), device :: bucket_part_d(*)
  integer(kind=4), device :: sortp_d(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: n_coarse

  integer :: thread_idx, block_idx, idx, h, ipart, seen, fine_rank, coarse_rank
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  h = head_idx + idx
  ipart = sortp_d(h)
  fine_rank = prefix_sum_d(h)
  seen = h - head_idx + 1
  coarse_rank = seen - fine_rank
  if (bucket_part_d(ipart) == 0) then
     swap_global_d(head_idx + coarse_rank - 1) = ipart
  else
     swap_global_d(head_idx + n_coarse + fine_rank - 1) = ipart
  endif
end subroutine write_swap_global_hilbert_partition

!> Column gather/scatter via xp_swap.
attributes(global) subroutine sort_gather_part_real_col(buf, src, swap_global_d, &
     head_idx, num_parts, leading, idim)
  integer(kind=4), intent(in), value :: leading
  integer(kind=4), intent(in), value :: idim
  real(kind=dp), device :: buf(*)
  real(kind=dp), device :: src(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, old_idx, off
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  old_idx = swap_global_d(idx)
  off = (idim - 1) * leading
  buf(idx) = src(old_idx + off)
end subroutine sort_gather_part_real_col

attributes(global) subroutine sort_scatter_part_real_col(dst, buf, &
     head_idx, num_parts, leading, idim)
  integer(kind=4), intent(in), value :: leading
  integer(kind=4), intent(in), value :: idim
  real(kind=dp), device :: dst(*)
  real(kind=dp), device :: buf(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, off
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  off = (idim - 1) * leading
  dst(idx + off) = buf(idx)
end subroutine sort_scatter_part_real_col

