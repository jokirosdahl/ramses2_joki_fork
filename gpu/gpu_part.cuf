!> Grow scan buffers to at least npart_max if needed.
subroutine ensure_scan_capacity_part(min_capacity)
  integer(kind=4), intent(in) :: min_capacity
  integer(kind=4), parameter :: block_size = 256
  integer(kind=4) :: gs0, gs1, gs2

  if (min_capacity <= 0) return

  if (allocated(swap_local)) then
     if (size(swap_local) < min_capacity) then
        deallocate(swap_local)
        allocate(swap_local(1:min_capacity))
     endif
  else
     allocate(swap_local(1:min_capacity))
  endif

  if (allocated(swap_global)) then
     if (size(swap_global) < min_capacity) then
        deallocate(swap_global)
        allocate(swap_global(1:min_capacity))
     endif
  else
     allocate(swap_global(1:min_capacity))
  endif

  if (allocated(prefix_sum)) then
     if (size(prefix_sum) < min_capacity) then
        deallocate(prefix_sum)
        allocate(prefix_sum(1:min_capacity))
     endif
  else
     allocate(prefix_sum(1:min_capacity))
  endif

  gs0 = max(1, (min_capacity + block_size - 1) / block_size)
  gs1 = max(1, (gs0 + block_size - 1) / block_size)
  gs2 = max(1, (gs1 + block_size - 1) / block_size)

  if (allocated(partial_sums_0)) then
     if (size(partial_sums_0) < gs0) then
        deallocate(partial_sums_0)
        allocate(partial_sums_0(1:gs0))
     endif
  else
     allocate(partial_sums_0(1:gs0))
  endif
  if (allocated(partial_sums_1)) then
     if (size(partial_sums_1) < gs1) then
        deallocate(partial_sums_1)
        allocate(partial_sums_1(1:gs1))
     endif
  else
     allocate(partial_sums_1(1:gs1))
  endif
  if (allocated(partial_sums_2)) then
     if (size(partial_sums_2) < gs2) then
        deallocate(partial_sums_2)
        allocate(partial_sums_2(1:gs2))
     endif
  else
     allocate(partial_sums_2(1:gs2))
  endif
end subroutine ensure_scan_capacity_part

!> Verbose-only: dump swap_global checksum and slot window during split.
subroutine dump_split_window_part(stage, head_idx, num_parts, ilevel)
  character(len=*), intent(in) :: stage
  integer(kind=4),  intent(in) :: head_idx, num_parts, ilevel

  integer(kind=4), parameter :: NWIN_SPLIT_DUMP = 16
  integer(kind=4) :: nwin_eff, k, idim
  integer(kind=4) :: slot
  real(kind=dp)   :: xp_h(NWIN_SPLIT_DUMP, ndim)
  real(kind=dp)   :: vp_h(NWIN_SPLIT_DUMP, ndim)
  real(kind=dp)   :: mp_h(NWIN_SPLIT_DUMP)
  integer(kind=4) :: levelp_h(NWIN_SPLIT_DUMP), swap_h(NWIN_SPLIT_DUMP)
  integer(i8b)    :: idp_h(NWIN_SPLIT_DUMP)
  integer(kind=4), allocatable :: swap_full_h(:)
  integer(kind=8) :: csum, csum_sq, csum_pos, sval
  integer(kind=4) :: smin, smax

  if (num_parts <= 0) return
  nwin_eff = min(NWIN_SPLIT_DUMP, num_parts)

  swap_h(1:nwin_eff)   = swap_global(head_idx:head_idx + nwin_eff - 1)
  idp_h(1:nwin_eff)    = idp(head_idx:head_idx + nwin_eff - 1)
  levelp_h(1:nwin_eff) = levelp(head_idx:head_idx + nwin_eff - 1)
  mp_h(1:nwin_eff)     = mp(head_idx:head_idx + nwin_eff - 1)
  do idim = 1, ndim
     xp_h(1:nwin_eff, idim) = xp(head_idx:head_idx + nwin_eff - 1, idim)
     vp_h(1:nwin_eff, idim) = vp(head_idx:head_idx + nwin_eff - 1, idim)
  end do

  allocate(swap_full_h(1:num_parts))
  swap_full_h(1:num_parts) = swap_global(head_idx:head_idx + num_parts - 1)
  csum     = 0_8
  csum_sq  = 0_8
  csum_pos = 0_8
  smin     = swap_full_h(1)
  smax     = swap_full_h(1)
  do k = 1, num_parts
     sval     = int(swap_full_h(k), kind=8)
     csum     = csum     + sval
     csum_sq  = csum_sq  + sval * sval
     csum_pos = csum_pos + int(k, kind=8) * sval
     if (swap_full_h(k) < smin) smin = swap_full_h(k)
     if (swap_full_h(k) > smax) smax = swap_full_h(k)
  end do
  deallocate(swap_full_h)

  write(*,'(A,I0,A,A,A,I0,A,I0,A,I0,A,I0,A,I0,A,I0,A,I0)') &
       ' split_part_csum: ilevel=', ilevel, ' stage=', trim(stage), &
       ' head=', head_idx, ' num=', num_parts, &
       ' csum=', csum, ' csum_sq=', csum_sq, &
       ' csum_pos=', csum_pos, &
       ' smin=', smin, ' smax=', smax

  do k = 1, nwin_eff
     slot = head_idx + k - 1
     if (ndim == 3) then
        write(*,'(A,I0,A,A,A,I0,A,I0,A,I0,A,I0,A,ES15.7,A,3(1X,ES15.7),A,3(1X,ES15.7))') &
             ' split_part_dump: ilevel=', ilevel, ' stage=', trim(stage), &
             ' slot=', slot, ' swap=', swap_h(k), &
             ' idp=', int(idp_h(k), kind=8), ' level=', levelp_h(k), &
             ' mp=', mp_h(k), &
             ' xp=', xp_h(k, 1), xp_h(k, 2), xp_h(k, 3), &
             ' vp=', vp_h(k, 1), vp_h(k, 2), vp_h(k, 3)
     else if (ndim == 2) then
        write(*,'(A,I0,A,A,A,I0,A,I0,A,I0,A,I0,A,ES15.7,A,2(1X,ES15.7),A,2(1X,ES15.7))') &
             ' split_part_dump: ilevel=', ilevel, ' stage=', trim(stage), &
             ' slot=', slot, ' swap=', swap_h(k), &
             ' idp=', int(idp_h(k), kind=8), ' level=', levelp_h(k), &
             ' mp=', mp_h(k), &
             ' xp=', xp_h(k, 1), xp_h(k, 2), &
             ' vp=', vp_h(k, 1), vp_h(k, 2)
     else
        write(*,'(A,I0,A,A,A,I0,A,I0,A,I0,A,I0,A,ES15.7,A,1X,ES15.7,A,1X,ES15.7)') &
             ' split_part_dump: ilevel=', ilevel, ' stage=', trim(stage), &
             ' slot=', slot, ' swap=', swap_h(k), &
             ' idp=', int(idp_h(k), kind=8), ' level=', levelp_h(k), &
             ' mp=', mp_h(k), &
             ' xp=', xp_h(k, 1), &
             ' vp=', vp_h(k, 1)
     endif
  end do
end subroutine dump_split_window_part

!> Per-slot kick gather dump: prints xp, vp, gathered ff (from fp), levelp, idp
!> for the first lev8 `gpu_kick_drift_part(action=1)` call. Targets the
!> first contiguous lev8 cluster from `315868` forensics (idp 1007296+).
!> Called only when `debug_kick .and. ilevel == 8 .and. action_part == 1`.
!> Reads device arrays via implicit device-to-host copy on slice assignment;
!> no local `device, allocatable` scratch (NVHPC invariant).
subroutine dump_kick_window_part(stage, head_idx, num_parts, ilevel, action_part, has_fp)
  character(len=*), intent(in) :: stage
  integer(kind=4),  intent(in) :: head_idx, num_parts, ilevel, action_part, has_fp

  integer(kind=4), parameter :: NWIN_KICK_DUMP = 16
  integer(i8b),    parameter :: IDP_LO = 1007296_i8b, IDP_HI = 1007426_i8b
  integer(kind=4) :: nwin_eff, k, idim, n_idp_hits
  integer(kind=4) :: slot
  real(kind=dp)   :: xp_h(NWIN_KICK_DUMP, ndim)
  real(kind=dp)   :: vp_h(NWIN_KICK_DUMP, ndim)
  real(kind=dp)   :: fp_h(NWIN_KICK_DUMP, ndim)
  integer(kind=4) :: levelp_h(NWIN_KICK_DUMP)
  integer(i8b)    :: idp_h(NWIN_KICK_DUMP)
  integer(i8b),    allocatable :: idp_full_h(:)
  integer(kind=4), allocatable :: hit_slots_h(:)
  integer(kind=4) :: m, n_print
  logical         :: ff_zero
  real(kind=dp)   :: ff_max

  if (num_parts <= 0) return

  ! Phase 1: head-of-range window (first NWIN_KICK_DUMP slots from head_idx).
  ! Matches dump_split_window_part layout; gives an anchor independent of idp.
  nwin_eff = min(NWIN_KICK_DUMP, num_parts)
  idp_h(1:nwin_eff)    = idp(head_idx:head_idx + nwin_eff - 1)
  levelp_h(1:nwin_eff) = levelp(head_idx:head_idx + nwin_eff - 1)
  do idim = 1, ndim
     xp_h(1:nwin_eff, idim) = xp(head_idx:head_idx + nwin_eff - 1, idim)
     vp_h(1:nwin_eff, idim) = vp(head_idx:head_idx + nwin_eff - 1, idim)
  end do
  if (has_fp /= 0 .and. allocated(fp)) then
     do idim = 1, ndim
        fp_h(1:nwin_eff, idim) = fp(head_idx:head_idx + nwin_eff - 1, idim)
     end do
  else
     fp_h(1:nwin_eff, 1:ndim) = 0d0
  endif

  do k = 1, nwin_eff
     slot = head_idx + k - 1
     ff_max = 0d0
     do idim = 1, ndim
        if (abs(fp_h(k, idim)) > ff_max) ff_max = abs(fp_h(k, idim))
     end do
     ff_zero = (has_fp == 0) .or. (ff_max == 0d0)
     if (ndim == 3) then
        write(*,'(A,A,A,A,I0,A,I0,A,I0,A,I0,A,I0,A,L1,A,3(1X,ES15.7),A,3(1X,ES15.7),A,3(1X,ES15.7))') &
             ' kick_part_dump: stage=', trim(stage), ' band=head', &
             ' ilevel=', ilevel, ' action=', action_part, &
             ' slot=', slot, ' idp=', int(idp_h(k), kind=8), &
             ' level=', levelp_h(k), ' ff_zero=', ff_zero, &
             ' xp=', xp_h(k, 1), xp_h(k, 2), xp_h(k, 3), &
             ' vp=', vp_h(k, 1), vp_h(k, 2), vp_h(k, 3), &
             ' ff=', fp_h(k, 1), fp_h(k, 2), fp_h(k, 3)
     else if (ndim == 2) then
        write(*,'(A,A,A,A,I0,A,I0,A,I0,A,I0,A,I0,A,L1,A,2(1X,ES15.7),A,2(1X,ES15.7),A,2(1X,ES15.7))') &
             ' kick_part_dump: stage=', trim(stage), ' band=head', &
             ' ilevel=', ilevel, ' action=', action_part, &
             ' slot=', slot, ' idp=', int(idp_h(k), kind=8), &
             ' level=', levelp_h(k), ' ff_zero=', ff_zero, &
             ' xp=', xp_h(k, 1), xp_h(k, 2), &
             ' vp=', vp_h(k, 1), vp_h(k, 2), &
             ' ff=', fp_h(k, 1), fp_h(k, 2)
     else
        write(*,'(A,A,A,A,I0,A,I0,A,I0,A,I0,A,I0,A,L1,A,1X,ES15.7,A,1X,ES15.7,A,1X,ES15.7)') &
             ' kick_part_dump: stage=', trim(stage), ' band=head', &
             ' ilevel=', ilevel, ' action=', action_part, &
             ' slot=', slot, ' idp=', int(idp_h(k), kind=8), &
             ' level=', levelp_h(k), ' ff_zero=', ff_zero, &
             ' xp=', xp_h(k, 1), &
             ' vp=', vp_h(k, 1), &
             ' ff=', fp_h(k, 1)
     endif
  end do

  ! Phase 2: idp-band scan. Pull idp(head:head+num_parts-1) to host once,
  ! find slots whose idp falls in the C-verified first-cluster band
  ! [IDP_LO, IDP_HI], then print up to NWIN_KICK_DUMP of them.
  allocate(idp_full_h(1:num_parts))
  idp_full_h(1:num_parts) = idp(head_idx:head_idx + num_parts - 1)
  allocate(hit_slots_h(1:NWIN_KICK_DUMP))
  n_idp_hits = 0
  do k = 1, num_parts
     if (idp_full_h(k) >= IDP_LO .and. idp_full_h(k) <= IDP_HI) then
        n_idp_hits = n_idp_hits + 1
        if (n_idp_hits <= NWIN_KICK_DUMP) then
           hit_slots_h(n_idp_hits) = head_idx + k - 1
        endif
     endif
  end do
  deallocate(idp_full_h)

  write(*,'(A,A,A,I0,A,I0,A,I0,A,I0,A,I0,A,I0,A,I0)') &
       ' kick_part_csum: stage=', trim(stage), &
       ' ilevel=', ilevel, ' action=', action_part, &
       ' head=', head_idx, ' num=', num_parts, &
       ' idp_lo=', int(IDP_LO, kind=8), ' idp_hi=', int(IDP_HI, kind=8), &
       ' idp_hits=', n_idp_hits

  n_print = min(n_idp_hits, NWIN_KICK_DUMP)
  do m = 1, n_print
     slot = hit_slots_h(m)
     idp_h(1)    = idp(slot)
     levelp_h(1) = levelp(slot)
     do idim = 1, ndim
        xp_h(1, idim) = xp(slot, idim)
        vp_h(1, idim) = vp(slot, idim)
     end do
     if (has_fp /= 0 .and. allocated(fp)) then
        do idim = 1, ndim
           fp_h(1, idim) = fp(slot, idim)
        end do
     else
        fp_h(1, 1:ndim) = 0d0
     endif
     ff_max = 0d0
     do idim = 1, ndim
        if (abs(fp_h(1, idim)) > ff_max) ff_max = abs(fp_h(1, idim))
     end do
     ff_zero = (has_fp == 0) .or. (ff_max == 0d0)
     if (ndim == 3) then
        write(*,'(A,A,A,A,I0,A,I0,A,I0,A,I0,A,I0,A,L1,A,3(1X,ES15.7),A,3(1X,ES15.7),A,3(1X,ES15.7))') &
             ' kick_part_dump: stage=', trim(stage), ' band=idp ', &
             ' ilevel=', ilevel, ' action=', action_part, &
             ' slot=', slot, ' idp=', int(idp_h(1), kind=8), &
             ' level=', levelp_h(1), ' ff_zero=', ff_zero, &
             ' xp=', xp_h(1, 1), xp_h(1, 2), xp_h(1, 3), &
             ' vp=', vp_h(1, 1), vp_h(1, 2), vp_h(1, 3), &
             ' ff=', fp_h(1, 1), fp_h(1, 2), fp_h(1, 3)
     else if (ndim == 2) then
        write(*,'(A,A,A,A,I0,A,I0,A,I0,A,I0,A,I0,A,L1,A,2(1X,ES15.7),A,2(1X,ES15.7),A,2(1X,ES15.7))') &
             ' kick_part_dump: stage=', trim(stage), ' band=idp ', &
             ' ilevel=', ilevel, ' action=', action_part, &
             ' slot=', slot, ' idp=', int(idp_h(1), kind=8), &
             ' level=', levelp_h(1), ' ff_zero=', ff_zero, &
             ' xp=', xp_h(1, 1), xp_h(1, 2), &
             ' vp=', vp_h(1, 1), vp_h(1, 2), &
             ' ff=', fp_h(1, 1), fp_h(1, 2)
     else
        write(*,'(A,A,A,A,I0,A,I0,A,I0,A,I0,A,I0,A,L1,A,1X,ES15.7,A,1X,ES15.7,A,1X,ES15.7)') &
             ' kick_part_dump: stage=', trim(stage), ' band=idp ', &
             ' ilevel=', ilevel, ' action=', action_part, &
             ' slot=', slot, ' idp=', int(idp_h(1), kind=8), &
             ' level=', levelp_h(1), ' ff_zero=', ff_zero, &
             ' xp=', xp_h(1, 1), &
             ' vp=', vp_h(1, 1), &
             ' ff=', fp_h(1, 1)
     endif
  end do
  deallocate(hit_slots_h)
end subroutine dump_kick_window_part

!> Partition particles coarse/fine and permute (host split_part).
subroutine gpu_split_part(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       compute_local_swap_table, update_global_swap_table
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, num_parts, n_fine, n_coarse, n_coarse_hilbert, ilev, leading
  integer :: num_threads, num_blocks, idim
  real(kind=8) :: dx_loc, skip1, skip2, skip3
  logical :: debug_split

  call nvtxStartRange("gpu_split_part", color=4) ! purple

  head_idx = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(sim%r%nlevelmax) - head_idx + 1

  if (num_parts <= 0) then
        sim%p%tailp(ilevel) = sim%p%headp(ilevel) - 1
     do ilev = ilevel + 1, sim%r%nlevelmax
        sim%p%headp(ilev) = sim%p%tailp(ilevel) + 1
        sim%p%tailp(ilev) = sim%p%npart
     end do
     call nvtxEndRange()
     return
  endif

  if (.not. allocated(xp)) then
     call nvtxEndRange()
     return
  endif

  leading = size(xp, 1)
  debug_split = sim%r%verbose .and. gpu_part_env_flag('GPU_PART_DEBUG_SPLIT')

  call ensure_scan_capacity_part(leading)

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  if (ilevel == sim%r%levelmin - 1) then
     call bucket_part_boundary<<<num_blocks, num_threads>>>(xp, bucket_part, &
          box_size, periodic, head_idx, num_parts, leading)
  else
     dx_loc = sim%r%boxlen / 2d0**ilevel
     ! Use parameter-keyed runtime ifs (not #if NDIM>=N) — see note inside
     ! bucket_part_general for why CPP cannot run on this file's body.
     skip1 = 0d0
     skip2 = 0d0
     skip3 = 0d0
     if (ndim >= 1) skip1 = sim%m%skip(1)
     if (ndim >= 2) skip2 = sim%m%skip(2)
     if (ndim >= 3) skip3 = sim%m%skip(3)
     call bucket_part_general<<<num_blocks, num_threads>>>(xp, bucket_part, &
          grid, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, &
          leading)
  endif
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(swap_global, &
       head_idx, num_parts)

  call init_prefix_sum_part<<<num_blocks, num_threads>>>(bucket_part, prefix_sum, &
       head_idx, num_parts)

  call gpu_scan(head_idx, num_parts, n_fine)
  n_coarse = num_parts - n_fine

  call compute_local_swap_table<<<num_blocks, num_threads>>>(swap_local, &
       swap_global, prefix_sum, head_idx, num_parts)

  call update_global_swap_table<<<num_blocks, num_threads>>>(swap_global, &
       swap_local, head_idx, num_parts)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  ! Re-order the coarse range of swap_global to match CPU's intentional
  ! Hilbert ordering at pm/rho_fine.f90:1416-1424 ("This enforces Hilbert
  ! ordering after partioning"). The slot-stable scan above already lands
  ! the fine bucket in slot order (matches CPU's fine loop at
  ! pm/rho_fine.f90:1407-1414); we only need to overwrite the coarse
  ! range with Hilbert-ranked coarse particles. Mismatch at dump 14 was
  ! the proximate cause of the mesh_000030+ CIC sum-order divergence in
  ! local-orderF-315315 (docs/triage/2026-05-19-diff-dumps-layout.md).
  call init_prefix_sum_part_hilbert_coarse<<<num_blocks, num_threads>>>( &
       bucket_part, sortp, prefix_sum, head_idx, num_parts)
  call gpu_scan(head_idx, num_parts, n_coarse_hilbert)
  call write_swap_global_coarse_hilbert<<<num_blocks, num_threads>>>( &
       swap_global, bucket_part, sortp, prefix_sum, head_idx, num_parts)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  if (debug_split .and. ilevel == 7) then
     call dump_split_window_part("before_xp", head_idx, num_parts, ilevel)
  endif

  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, xp, &
          swap_global, head_idx, num_parts, leading, idim)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(xp, xp_swap, &
          head_idx, num_parts, leading, idim)
  end do

  if (debug_split .and. ilevel == 7) then
     call dump_split_window_part("after_xp", head_idx, num_parts, ilevel)
  endif

  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, vp, &
          swap_global, head_idx, num_parts, leading, idim)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(vp, xp_swap, &
          head_idx, num_parts, leading, idim)
  end do

  if (debug_split .and. ilevel == 7) then
     call dump_split_window_part("after_vp", head_idx, num_parts, ilevel)
  endif

  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, mp, &
       swap_global, head_idx, num_parts)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(mp, mp_swap, &
       head_idx, num_parts)

  call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(workp, levelp, &
       swap_global, head_idx, num_parts)
  call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(levelp, workp, &
       head_idx, num_parts)

  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, idp, &
       swap_global, head_idx, num_parts)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(idp, idp_swap, &
       head_idx, num_parts)

  if (debug_split .and. ilevel == 7) then
     call dump_split_window_part("after_idmpl", head_idx, num_parts, ilevel)
  endif

  if (allocated(fp)) then
     do idim = 1, ndim
        call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, fp, &
             swap_global, head_idx, num_parts, leading, idim)
        call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(fp, xp_swap, &
             head_idx, num_parts, leading, idim)
     end do
  endif
  if (allocated(jp)) then
     do idim = 1, ndim
        call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, jp, &
             swap_global, head_idx, num_parts, leading, idim)
        call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(jp, xp_swap, &
             head_idx, num_parts, leading, idim)
     end do
  endif
  if (allocated(zp)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, zp, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(zp, mp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(tp)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, tp, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(tp, mp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(tm)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, tm, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(tm, mp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(size_p)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, size_p, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(size_p, mp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(charge)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, charge, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(charge, mp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(idm)) then
     call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, idm, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(idm, idp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(idt)) then
     call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(workp, idt, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(idt, workp, &
          head_idx, num_parts)
  endif
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  sim%p%tailp(ilevel) = sim%p%headp(ilevel) + n_coarse - 1
  do ilev = ilevel + 1, sim%r%nlevelmax
     sim%p%headp(ilev) = sim%p%tailp(ilevel) + 1
     sim%p%tailp(ilev) = sim%p%npart
  end do

  call nvtxEndRange()
end subroutine gpu_split_part

!> Hilbert key at oct level ilevel-1 (matches host sort_hilbert).
attributes(global) subroutine compute_hkey_part_kernel(xp, hkey_part_d, &
     skip1, skip2, skip3, dx_inv, head_idx, num_parts, leading, level)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp),   device :: xp(*)
  integer(kind=8), device :: hkey_part_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3
  real(kind=8), intent(in), value :: dx_inv
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: level

  integer :: thread_idx, block_idx, idx, ipart, idim
  integer(kind=4) :: ix(1:ndim)
  real(kind=8) :: skip(1:3), xs

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  do idim = 1, ndim
     xs = xp(ipart + (idim-1)*leading) + skip(idim)
     ix(idim) = floor(xs * dx_inv)
  end do

  hkey_part_d(ipart) = hilbert_key(ix, level)
end subroutine compute_hkey_part_kernel

!> Radix digit (1 bit) for hkey_part (stable LSD sort).
attributes(global) subroutine init_prefix_sum_part_bit(hkey_part_d, swap_global_d, &
     prefix_sum_d, head_idx, num_parts, ibit)
  integer(kind=8), device :: hkey_part_d(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: ibit

  integer :: thread_idx, block_idx, idx, old_idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx

  old_idx = swap_global_d(idx)
  prefix_sum_d(idx) = int(ibits(hkey_part_d(old_idx), ibit, 1), kind=4)
end subroutine init_prefix_sum_part_bit

!> sortp(i) := original index at position i after radix sort.
attributes(global) subroutine write_sortp_part(sortp_d, swap_global_d, &
     head_idx, num_parts)
  integer(kind=4), device :: sortp_d(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  sortp_d(idx) = swap_global_d(idx)
end subroutine write_sortp_part

!> Hilbert-sort particles; updates sortp only (host sort_part).
subroutine gpu_sort_part(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       compute_local_swap_table, update_global_swap_table
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, num_parts, total_sum, leading
  integer :: num_threads, num_blocks
  integer :: ibit, level
  real(kind=8) :: dx_inv, skip1, skip2, skip3

  call nvtxStartRange("gpu_sort_part", color=4) ! purple

  head_idx  = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(sim%r%nlevelmax) - head_idx + 1

  if (num_parts <= 0) then
     call nvtxEndRange()
     return
  endif

  if (.not. allocated(xp)) then
     call nvtxEndRange()
     return
  endif

  leading = size(xp, 1)
  call ensure_scan_capacity_part(leading)

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  level = ilevel - 1
  if (level <= 0) then
     call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(swap_global, &
          head_idx, num_parts)
     call write_sortp_part<<<num_blocks, num_threads>>>(sortp, swap_global, &
          head_idx, num_parts)
     call GPU_Error_Check("gpu/gpu_part.cuf", 0)
     call nvtxEndRange()
     return
  endif

  dx_inv = 2.0d0**(ilevel-1) / sim%r%boxlen
  skip1 = 0d0
  skip2 = 0d0
  skip3 = 0d0
  if (ndim >= 1) skip1 = sim%m%skip(1)
  if (ndim >= 2) skip2 = sim%m%skip(2)
  if (ndim >= 3) skip3 = sim%m%skip(3)
  call compute_hkey_part_kernel<<<num_blocks, num_threads>>>(xp, hkey_part, &
       skip1, skip2, skip3, dx_inv, head_idx, num_parts, leading, level)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(swap_global, &
       head_idx, num_parts)

  do ibit = 0, ndim * level - 1
     call init_prefix_sum_part_bit<<<num_blocks, num_threads>>>(hkey_part, &
          swap_global, prefix_sum, head_idx, num_parts, ibit)
     call gpu_scan(head_idx, num_parts, total_sum)
     call compute_local_swap_table<<<num_blocks, num_threads>>>(swap_local, &
          swap_global, prefix_sum, head_idx, num_parts)
     call update_global_swap_table<<<num_blocks, num_threads>>>(swap_global, &
          swap_local, head_idx, num_parts)
  end do
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  call write_sortp_part<<<num_blocks, num_threads>>>(sortp, swap_global, &
       head_idx, num_parts)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  call nvtxEndRange()
end subroutine gpu_sort_part
!> Pre-segmented CIC deposition into rho/nref (global atomicAdd).
attributes(global) subroutine cic_part_atomic_kernel(xp_d, mp_d, sortp_d, rho_d, nref_d, &
     hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     box_ckey_min_d, box_ckey_max_d, periodic_d, &
     skip1, skip2, skip3, dx_loc, vol_loc, m_refine_at_level, mass_cut_refine, &
     ilevel, head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: mp_d(*)
  integer(kind=4), device :: sortp_d(*)
  real(kind=dp),   device :: rho_d(1:twotondim,*)
  real(kind=dp),   device :: nref_d(1:twotondim,*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3,*)
  integer(kind=4), device :: box_ckey_max_d(1:3,*)
  logical,         device :: periodic_d(1:3)
  real(kind=8), intent(in), value :: skip1, skip2, skip3
  real(kind=8), intent(in), value :: dx_loc, vol_loc
  real(kind=8), intent(in), value :: m_refine_at_level, mass_cut_refine
  integer(kind=4), intent(in), value :: ilevel
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, isort, ipart, idim
  integer :: ox, oy, oz, igrid, icell
  integer(kind=4) :: host_ckey(1:3), target_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=4) :: box_min(1:3), box_max(1:3)
  integer(kind=8) :: nx, offset, key, ix8, iy8, iz8
  real(kind=8) :: skip(1:3), x(1:3), frac(1:3)
  real(kind=8) :: wx(0:2), wy(0:2), wz(0:2), weight, deposit, nref_add
  real(kind=dp) :: old_value
  logical :: in_domain

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return

  isort = head_idx + idx
  ipart = sortp_d(isort)

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  host_ckey = 0
  frac = 0d0
  do idim = 1, ndim
     x(idim) = (xp_d(ipart + (idim-1)*leading) + skip(idim)) / dx_loc
     host_ckey(idim) = floor(x(idim))
     frac(idim) = x(idim) - real(host_ckey(idim), kind=8)
  end do

  wx(0) = max(0d0, 0.5d0 - frac(1))
  wx(1) = 1d0 - abs(frac(1) - 0.5d0)
  wx(2) = max(0d0, frac(1) - 0.5d0)
  wy = 0d0
  wz = 0d0
  wy(1) = 1d0
  wz(1) = 1d0
  if (ndim >= 2) then
     wy(0) = max(0d0, 0.5d0 - frac(2))
     wy(1) = 1d0 - abs(frac(2) - 0.5d0)
     wy(2) = max(0d0, frac(2) - 0.5d0)
  endif
  if (ndim >= 3) then
     wz(0) = max(0d0, 0.5d0 - frac(3))
     wz(1) = 1d0 - abs(frac(3) - 0.5d0)
     wz(2) = max(0d0, frac(3) - 0.5d0)
  endif

  box_min = 0
  box_max = 0
  do idim = 1, ndim
     box_min(idim) = box_ckey_min_d(idim, ilevel+1)
     box_max(idim) = box_ckey_max_d(idim, ilevel+1)
  end do

  do oz = -1, 1
     do oy = -1, 1
        do ox = -1, 1
           weight = wx(ox+1) * wy(oy+1) * wz(oz+1)

           target_ckey = 0
           target_ckey(1) = host_ckey(1) + ox
           if (ndim >= 2) target_ckey(2) = host_ckey(2) + oy
           if (ndim >= 3) target_ckey(3) = host_ckey(3) + oz

           in_domain = .true.
           do idim = 1, ndim
              if (periodic_d(idim)) then
                 if (target_ckey(idim) < box_min(idim))  target_ckey(idim) = box_max(idim) - 1
                 if (target_ckey(idim) >= box_max(idim)) target_ckey(idim) = box_min(idim)
              else
                 if (target_ckey(idim) < box_min(idim))  in_domain = .false.
                 if (target_ckey(idim) >= box_max(idim)) in_domain = .false.
              endif
           end do
           if (.not. in_domain) cycle

           father_ckey = target_ckey / 2
           ii = target_ckey - 2 * father_ckey
           icell = 1
           do idim = 1, ndim
              icell = icell + ii(idim) * (2**(idim-1))
           end do

           ix8 = int(father_ckey(1), kind=8)
           iy8 = int(father_ckey(2), kind=8)
           iz8 = int(father_ckey(3), kind=8)
           nx  = int(ckey_max_d(ilevel), kind=8)
           offset = key_off_d(ilevel)
           key = offset + ix8 + iy8*nx + iz8*nx*nx
           igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
           if (igrid == 0) cycle

           deposit = mp_d(ipart) * weight / vol_loc
           old_value = atomicadd(rho_d(icell, igrid), deposit)

           if (m_refine_at_level >= 0d0) then
              if (mass_cut_refine > 0d0) then
                 if (mp_d(ipart) < mass_cut_refine) then
                    nref_add = weight
                 else
                    nref_add = 0d0
                 endif
              else
                 nref_add = weight
              endif
              if (nref_add /= 0d0) old_value = atomicadd(nref_d(icell, igrid), nref_add)
           endif
        end do
     end do
  end do
end subroutine cic_part_atomic_kernel

!> Host dispatcher for the pre-segmented CIC path.
subroutine gpu_cic_part_atomic(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, num_parts, leading
  integer :: num_threads, num_blocks, i, idim
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3

  call nvtxStartRange("gpu_cic_part_atomic", color=4) ! purple

  if (rtype /= 0 .and. rtype /= 1) then
     call nvtxEndRange()
     return
  endif
  if (.not. allocated(xp)) then
     call nvtxEndRange()
     return
  endif

  if (ilevel == sim%r%levelmin) then
     do i = 1, sim%p%npart
        sim%g%multipole%q(1) = sim%g%multipole%q(1) + sim%p%mp(i)
     end do
     do idim = 1, ndim
        do i = 1, sim%p%npart
           sim%g%multipole%q(idim+1) = sim%g%multipole%q(idim+1) + sim%p%mp(i) * sim%p%xp(i,idim)
        end do
     end do
  endif

  head_idx  = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(sim%r%nlevelmax) - head_idx + 1
  if (num_parts <= 0) then
     call nvtxEndRange()
     return
  endif

  leading = size(xp, 1)
  dx_loc  = sim%r%boxlen / 2d0**ilevel
  vol_loc = dx_loc**ndim
  skip1 = 0d0
  skip2 = 0d0
  skip3 = 0d0
  if (ndim >= 1) skip1 = sim%m%skip(1)
  if (ndim >= 2) skip2 = sim%m%skip(2)
  if (ndim >= 3) skip3 = sim%m%skip(3)

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads
  call cic_part_atomic_kernel<<<num_blocks, num_threads>>>(xp, mp, sortp, rho, nref, &
       hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       box_ckey_min, box_ckey_max, periodic, &
       skip1, skip2, skip3, dx_loc, vol_loc, sim%r%m_refine(ilevel), sim%r%mass_cut_refine, &
       ilevel, head_idx, num_parts, leading)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  call nvtxEndRange()
end subroutine gpu_cic_part_atomic

!> §15.16 Step 0 — zero cell_part_count over the rank-2 (twotondim, igrid)
!> table, for the igrid range we will deposit into. Launch is flat over
!> twotondim * num_grids; one thread per (icell, igrid) slot.
attributes(global) subroutine reset_cell_part_count_kernel(cell_part_count_d, num_grids)
  integer(kind=4), intent(in), value :: num_grids
  integer(kind=4), device :: cell_part_count_d(1:twotondim, *)

  integer :: thread_idx, block_idx, idx, icell, igrid
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= twotondim * num_grids) return
  icell = mod(idx, twotondim) + 1
  igrid = idx / twotondim + 1
  cell_part_count_d(icell, igrid) = 0
end subroutine reset_cell_part_count_kernel

!> §15.16 Step 0 count pass — for each particle in the level slice, compute
!> its level-(ilevel+1) host cell (icell_src, igrid_src) and atomically
!> increment cell_part_count. Also store the per-particle source-cell map
!> (src_icell_part / src_igrid_part) so Step 1's weight kernel does not
!> repeat the hash_get for every outer-k iteration (§15.18 amortization).
!> Particles whose host oct hash-misses get sentinel igrid_src = 0 and are
!> dropped from the cell-list segmentation.
attributes(global) subroutine build_cell_part_count_kernel(xp_d, &
     cell_part_count_d, src_icell_part_d, src_igrid_part_d, &
     hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp),   device :: xp_d(*)
  integer(kind=4), device :: cell_part_count_d(1:twotondim, *)
  integer(kind=4), device :: src_icell_part_d(*)
  integer(kind=4), device :: src_igrid_part_d(*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3, dx_loc
  integer(kind=4), intent(in), value :: ilevel, head_idx, num_parts

  integer :: thread_idx, block_idx, idx, ipart, idim, igrid, icell, old
  integer(kind=4) :: host_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=8) :: nx, offset, key, ix8, iy8, iz8
  real(kind=8) :: skip(1:3), xs, inv_dx_loc

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3
  inv_dx_loc = 1d0 / dx_loc

  host_ckey = 0
  do idim = 1, ndim
     xs = (xp_d(ipart + (idim-1)*leading) + skip(idim)) * inv_dx_loc
     host_ckey(idim) = floor(xs)
  end do

  father_ckey = host_ckey / 2
  ii = host_ckey - 2 * father_ckey
  icell = 1
  do idim = 1, ndim
     icell = icell + ii(idim) * (2**(idim-1))
  end do

  ix8 = int(father_ckey(1), kind=8)
  iy8 = int(father_ckey(2), kind=8)
  iz8 = int(father_ckey(3), kind=8)
  nx  = int(ckey_max_d(ilevel), kind=8)
  offset = key_off_d(ilevel)
  key = offset + ix8 + iy8*nx + iz8*nx*nx
  igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

  src_icell_part_d(ipart) = icell
  src_igrid_part_d(ipart) = igrid

  if (igrid == 0) return    ! sentinel: drop out-of-domain particle

  old = atomicadd(cell_part_count_d(icell, igrid), 1)
end subroutine build_cell_part_count_kernel

!> Flatten cell_part_count(icell, igrid) into the 1D prefix_sum scratch so
!> we can hand it to gpu_scan. One thread per flat slot.
attributes(global) subroutine flatten_cell_count_kernel(cell_part_count_d, &
     prefix_sum_d, num_grids)
  integer(kind=4), intent(in), value :: num_grids
  integer(kind=4), device :: cell_part_count_d(1:twotondim, *)
  integer(kind=4), device :: prefix_sum_d(*)

  integer :: thread_idx, block_idx, idx, icell, igrid
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= twotondim * num_grids) return
  icell = mod(idx, twotondim) + 1
  igrid = idx / twotondim + 1
  prefix_sum_d(idx + 1) = cell_part_count_d(icell, igrid)
end subroutine flatten_cell_count_kernel

!> After gpu_scan, prefix_sum holds the INCLUSIVE scan of cell_part_count.
!> Write cell_part_head = prefix_sum - count (exclusive scan, so it points
!> at the first slot of the cell in cell_part_idx) AND re-zero
!> cell_part_count so it can serve as the per-cell place-pass counter.
attributes(global) subroutine compute_cell_part_head_kernel(cell_part_count_d, &
     cell_part_head_d, prefix_sum_d, num_grids)
  integer(kind=4), intent(in), value :: num_grids
  integer(kind=4), device :: cell_part_count_d(1:twotondim, *)
  integer(kind=4), device :: cell_part_head_d (1:twotondim, *)
  integer(kind=4), device :: prefix_sum_d(*)

  integer :: thread_idx, block_idx, idx, icell, igrid, incl, cnt
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= twotondim * num_grids) return
  icell = mod(idx, twotondim) + 1
  igrid = idx / twotondim + 1
  incl = prefix_sum_d(idx + 1)
  cnt  = cell_part_count_d(icell, igrid)
  cell_part_head_d(icell, igrid)  = incl - cnt
  cell_part_count_d(icell, igrid) = 0
end subroutine compute_cell_part_head_kernel

!> §15.16 Step 0 place pass — for each particle, write its ipart into the
!> per-cell segment of cell_part_idx at slot = head + atomicAdd(count, 1).
!> After this kernel, cell_part_count is restored to its post-Step-0-count
!> value (the original counts), and cell_part_idx is the slot->ipart map.
attributes(global) subroutine place_cell_part_idx_kernel(cell_part_count_d, &
     cell_part_head_d, cell_part_idx_d, src_icell_part_d, src_igrid_part_d, &
     head_idx, num_parts)
  integer(kind=4), device :: cell_part_count_d(1:twotondim, *)
  integer(kind=4), device :: cell_part_head_d (1:twotondim, *)
  integer(kind=4), device :: cell_part_idx_d(*)
  integer(kind=4), device :: src_icell_part_d(*)
  integer(kind=4), device :: src_igrid_part_d(*)
  integer(kind=4), intent(in), value :: head_idx, num_parts

  integer :: thread_idx, block_idx, idx, ipart, icell, igrid, slot_off, slot
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx
  icell = src_icell_part_d(ipart)
  igrid = src_igrid_part_d(ipart)
  if (igrid == 0) return
  slot_off = atomicadd(cell_part_count_d(icell, igrid), 1)
  slot = cell_part_head_d(icell, igrid) + slot_off + 1
  cell_part_idx_d(slot) = ipart
end subroutine place_cell_part_idx_kernel

!> §15.16 Step 0b — for each non-empty source cell (icell_src, igrid_src)
!> and each k in 1..threetondim (= 27 in 3D), precompute the destination
!> (igrid_dst, icell_dst) reached by adding the k-th stencil offset to the
!> source cell's level-(ilevel+1) Cartesian key. Periodic wrap is per-dim
!> against box_ckey_min/max(idim, ilevel+1); out-of-domain destinations
!> (non-periodic dim out of bounds, or hash_get miss) get sentinel
!> (dst_igrid = 0, dst_icell = 0) and Step 1 zeros their weight (§15.21).
attributes(global) subroutine build_dest_oct_per_cell_kernel(grid_d, cell_part_count_d, &
     dest_oct_d, dest_icell_d, hash_key_d, hash_val_d, hash_size_d, &
     ckey_max_d, key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, &
     ilevel, num_grids)
  integer(kind=4), intent(in), value :: ilevel, num_grids
  type(oct),       device :: grid_d(*)
  integer(kind=4), device :: cell_part_count_d(1:twotondim, *)
  integer(kind=4), device :: dest_oct_d  (1:threetondim, 1:twotondim, *)
  integer(kind=4), device :: dest_icell_d(1:threetondim, 1:twotondim, *)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3, *)
  integer(kind=4), device :: box_ckey_max_d(1:3, *)
  logical,         device :: periodic_d(1:3)

  integer :: thread_idx, block_idx, idx, k, icell_src, igrid_src, idim
  integer :: ox, oy, oz, igrid_dst, icell_dst
  integer(kind=4) :: src_full_ckey(1:3), target_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=4) :: ii_src(1:3), box_min(1:3), box_max(1:3)
  integer(kind=8) :: nx, offset, key, ix8, iy8, iz8
  logical :: in_domain

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= threetondim * twotondim * num_grids) return

  ! Unflatten idx -> (k, icell_src, igrid_src). twotondim is the inner stride.
  k         = mod(idx, threetondim) + 1
  icell_src = mod(idx / threetondim, twotondim) + 1
  igrid_src = idx / (threetondim * twotondim) + 1

  if (cell_part_count_d(icell_src, igrid_src) == 0) then
     dest_oct_d  (k, icell_src, igrid_src) = 0
     dest_icell_d(k, icell_src, igrid_src) = 0
     return
  endif

  ! Decode (icell_src - 1) -> ii_src(1:ndim) in {0,1}.
  ii_src = 0
  do idim = 1, ndim
     ii_src(idim) = mod((icell_src - 1) / (2**(idim-1)), 2)
  end do

  ! Source cell's level-(ilevel+1) full Cartesian key.
  src_full_ckey = 0
  do idim = 1, ndim
     src_full_ckey(idim) = 2 * grid_d(igrid_src)%ckey(idim) + ii_src(idim)
  end do

  ! Decode (k-1) -> (ox, oy, oz) in {-1, 0, +1}. 3D layout: oz outermost.
  ox = mod(k - 1, 3) - 1
  oy = mod((k - 1) / 3, 3) - 1
  oz = (k - 1) / 9 - 1

  target_ckey = 0
  target_ckey(1) = src_full_ckey(1) + ox
  if (ndim >= 2) target_ckey(2) = src_full_ckey(2) + oy
  if (ndim >= 3) target_ckey(3) = src_full_ckey(3) + oz

  box_min = 0
  box_max = 0
  do idim = 1, ndim
     box_min(idim) = box_ckey_min_d(idim, ilevel+1)
     box_max(idim) = box_ckey_max_d(idim, ilevel+1)
  end do

  in_domain = .true.
  do idim = 1, ndim
     if (periodic_d(idim)) then
        if (target_ckey(idim) < box_min(idim))  target_ckey(idim) = box_max(idim) - 1
        if (target_ckey(idim) >= box_max(idim)) target_ckey(idim) = box_min(idim)
     else
        if (target_ckey(idim) < box_min(idim))  in_domain = .false.
        if (target_ckey(idim) >= box_max(idim)) in_domain = .false.
     endif
  end do

  if (.not. in_domain) then
     dest_oct_d  (k, icell_src, igrid_src) = 0
     dest_icell_d(k, icell_src, igrid_src) = 0
     return
  endif

  father_ckey = target_ckey / 2
  ii = target_ckey - 2 * father_ckey
  icell_dst = 1
  do idim = 1, ndim
     icell_dst = icell_dst + ii(idim) * (2**(idim-1))
  end do

  ix8 = int(father_ckey(1), kind=8)
  iy8 = int(father_ckey(2), kind=8)
  iz8 = int(father_ckey(3), kind=8)
  nx  = int(ckey_max_d(ilevel), kind=8)
  offset = key_off_d(ilevel)
  key = offset + ix8 + iy8*nx + iz8*nx*nx
  igrid_dst = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

  dest_oct_d  (k, icell_src, igrid_src) = igrid_dst
  dest_icell_d(k, icell_src, igrid_src) = icell_dst
end subroutine build_dest_oct_per_cell_kernel

!> §15.20 / Stage (d) — GPU `multipole_q` reduction over the full particle
!> slice [1, npart]. Mirrors gpu_rho.cuf:multipole_tot — per-thread load,
!> block_reduce_sum on each of (ndim+1) components, single atomicadd per
!> block to the length-(ndim+1) device accumulator. Replaces the serial
!> host loop at gpu_cic_part:942-951 which read stale host xp/mp when
!> data_on_device=.true.
attributes(global) subroutine multipole_q_kernel(xp_d, mp_d, multipole_q_d, &
     num_parts, leading)
  integer(kind=4), intent(in), value :: leading, num_parts
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: mp_d(*)
  real(kind=8),    device :: multipole_q_d(1:ndim+1)

  integer :: thread_idx, block_idx, ipart, idim, info
  real(kind=8) :: q_loc(1:ndim+1)

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  ipart = thread_idx + block_idx * blockDim%x + 1

  q_loc = 0d0
  if (ipart <= num_parts) then
     q_loc(1) = mp_d(ipart)
     do idim = 1, ndim
        q_loc(idim+1) = mp_d(ipart) * xp_d(ipart + (idim-1)*leading)
     end do
  endif

  do idim = 1, ndim+1
     q_loc(idim) = block_reduce_sum(q_loc(idim))
  end do

  if (threadIdx%x == 1) then
     do idim = 1, ndim+1
        info = atomicadd(multipole_q_d(idim), q_loc(idim))
     end do
  endif
end subroutine multipole_q_kernel

!> §15.16 Step 1 — per-particle weight kernel for outer iteration k.
!> Parallel over particles in the level slice. Each thread:
!>   - reads its source cell (icell_src, igrid_src) from the per-particle map,
!>   - reads its destination (dst_igrid, dst_icell) = dest_oct_per_cell(k, ...),
!>   - computes the CIC weight wx(ox+1)*wy(oy+1)*wz(oz+1) from its frac,
!>   - writes weight_part_rho(ipart) = mp*w/vol_loc and the gated nref weight.
!> Sentinel (dropped source or out-of-domain destination) -> weight = 0.
attributes(global) subroutine cic_weight_kernel(xp_d, mp_d, &
     src_icell_part_d, src_igrid_part_d, dest_oct_d, &
     weight_rho_d, weight_nref_d, &
     skip1, skip2, skip3, dx_loc, vol_loc, m_refine_at_level, mass_cut_refine, &
     k_outer, head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading, k_outer, head_idx, num_parts
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: mp_d(*)
  integer(kind=4), device :: src_icell_part_d(*)
  integer(kind=4), device :: src_igrid_part_d(*)
  integer(kind=4), device :: dest_oct_d(1:threetondim, 1:twotondim, *)
  real(kind=dp),   device :: weight_rho_d (*)
  real(kind=dp),   device :: weight_nref_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3, dx_loc, vol_loc
  real(kind=8), intent(in), value :: m_refine_at_level, mass_cut_refine

  integer :: thread_idx, block_idx, idx, ipart, idim, icell_src, igrid_src
  integer :: ox, oy, oz, dst_igrid
  real(kind=8) :: skip(1:3), xs, frac(1:3)
  real(kind=8) :: wx(0:2), wy(0:2), wz(0:2), w, nref_add

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  weight_rho_d (ipart) = 0d0
  weight_nref_d(ipart) = 0d0

  icell_src = src_icell_part_d(ipart)
  igrid_src = src_igrid_part_d(ipart)
  if (igrid_src == 0) return    ! source out-of-domain: contributes nothing

  dst_igrid = dest_oct_d(k_outer, icell_src, igrid_src)
  if (dst_igrid == 0) return    ! destination out-of-domain (§15.21)

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3
  frac = 0d0
  do idim = 1, ndim
     xs = (xp_d(ipart + (idim-1)*leading) + skip(idim)) / dx_loc
     frac(idim) = xs - floor(xs)
  end do

  wx(0) = max(0d0, 0.5d0 - frac(1))
  wx(1) = 1d0 - abs(frac(1) - 0.5d0)
  wx(2) = max(0d0, frac(1) - 0.5d0)
  wy = 0d0
  wz = 0d0
  wy(1) = 1d0
  wz(1) = 1d0
  if (ndim >= 2) then
     wy(0) = max(0d0, 0.5d0 - frac(2))
     wy(1) = 1d0 - abs(frac(2) - 0.5d0)
     wy(2) = max(0d0, frac(2) - 0.5d0)
  endif
  if (ndim >= 3) then
     wz(0) = max(0d0, 0.5d0 - frac(3))
     wz(1) = 1d0 - abs(frac(3) - 0.5d0)
     wz(2) = max(0d0, frac(3) - 0.5d0)
  endif

  ox = mod(k_outer - 1, 3) - 1
  oy = mod((k_outer - 1) / 3, 3) - 1
  oz = (k_outer - 1) / 9 - 1
  w = wx(ox+1) * wy(oy+1) * wz(oz+1)

  weight_rho_d(ipart) = mp_d(ipart) * w / vol_loc

  if (m_refine_at_level >= 0d0) then
     if (mass_cut_refine > 0d0) then
        if (mp_d(ipart) < mass_cut_refine) then
           nref_add = w
        else
           nref_add = 0d0
        endif
     else
        nref_add = w
     endif
     weight_nref_d(ipart) = nref_add
  endif
end subroutine cic_weight_kernel

!> §15.16 Step 2+3 — per-source-cell reduction + leader write. One CUDA
!> block per (icell_src, igrid_src) source cell; threads = particles in
!> that cell. Two block_reduce_sum calls (rho, nref) on each particle's
!> precomputed weight. Thread 0 (leader) reads dest_oct_per_cell to find
!> the destination and writes rho/nref += total. **No global atomics**:
!> within iteration k_outer, distinct source cells map to distinct
!> destinations (offset_k is a lattice bijection modulo periodic wrap).
!> Cross-iteration += across the threetondim outer iterations is serialized
!> by the host launching them in sequence.
attributes(global) subroutine cic_block_reduce_kernel(cell_part_count_d, &
     cell_part_head_d, cell_part_idx_d, dest_oct_d, dest_icell_d, &
     weight_rho_d, weight_nref_d, rho_d, nref_d, &
     m_refine_at_level, k_outer, num_grids)
  integer(kind=4), intent(in), value :: k_outer, num_grids
  integer(kind=4), device :: cell_part_count_d(1:twotondim, *)
  integer(kind=4), device :: cell_part_head_d (1:twotondim, *)
  integer(kind=4), device :: cell_part_idx_d(*)
  integer(kind=4), device :: dest_oct_d  (1:threetondim, 1:twotondim, *)
  integer(kind=4), device :: dest_icell_d(1:threetondim, 1:twotondim, *)
  real(kind=dp),   device :: weight_rho_d (*)
  real(kind=dp),   device :: weight_nref_d(*)
  real(kind=dp),   device :: rho_d (1:twotondim, *)
  real(kind=dp),   device :: nref_d(1:twotondim, *)
  real(kind=8), intent(in), value :: m_refine_at_level

  integer :: block_idx_flat, icell_src, igrid_src, count, head
  integer :: tid, block_size, chunk_start, chunk_size, slot, ipart
  integer :: dst_igrid, dst_icell
  real(kind=8) :: my_rho, my_nref, total_rho, total_nref

  block_idx_flat = blockIdx%x - 1
  if (block_idx_flat >= twotondim * num_grids) return

  icell_src = mod(block_idx_flat, twotondim) + 1
  igrid_src = block_idx_flat / twotondim + 1

  count = cell_part_count_d(icell_src, igrid_src)
  if (count == 0) return

  dst_igrid = dest_oct_d  (k_outer, icell_src, igrid_src)
  if (dst_igrid == 0) return    ! destination out-of-domain (§15.21)
  dst_icell = dest_icell_d(k_outer, icell_src, igrid_src)

  head = cell_part_head_d(icell_src, igrid_src)
  block_size = blockDim%x
  tid = threadIdx%x - 1

  total_rho  = 0d0
  total_nref = 0d0

  ! Inner serial chunk-loop: cells exceeding block size (>1024 on H100) are
  ! rare in the namelists in scope; loop is correct for any count.
  chunk_start = 0
  do while (chunk_start < count)
     chunk_size = min(block_size, count - chunk_start)
     if (tid < chunk_size) then
        slot = head + chunk_start + tid + 1
        ipart = cell_part_idx_d(slot)
        my_rho  = weight_rho_d (ipart)
        my_nref = weight_nref_d(ipart)
     else
        my_rho  = 0d0
        my_nref = 0d0
     endif
     my_rho  = block_reduce_sum(my_rho)
     my_nref = block_reduce_sum(my_nref)
     if (tid == 0) then
        total_rho  = total_rho  + my_rho
        total_nref = total_nref + my_nref
     endif
     chunk_start = chunk_start + block_size
  end do

  if (tid == 0) then
     rho_d(dst_icell, dst_igrid) = rho_d(dst_icell, dst_igrid) + total_rho
     if (m_refine_at_level >= 0d0) then
        nref_d(dst_icell, dst_igrid) = nref_d(dst_icell, dst_igrid) + total_nref
     endif
  endif
end subroutine cic_block_reduce_kernel

!> Host CIC dispatcher. Default is the old atomic path; set
!> GPU_CIC_SEGMENTED=1 to run the §15.16 path for A/B isolation.
subroutine gpu_cic_part(sim, ilevel, rtype)
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  if (gpu_part_env_flag('GPU_CIC_SEGMENTED')) then
     call gpu_cic_part_segmented(sim, ilevel, rtype)
  else
     call gpu_cic_part_atomic(sim, ilevel, rtype)
  endif
end subroutine gpu_cic_part

!> Host dispatcher for CIC deposition (§15.16 segmented-reduction redesign).
!>
!> Pipeline:
!>   Step 0    cell-list at level (ilevel+1) — cell_part_count/head/idx and
!>             the per-particle source-cell map src_icell_part/src_igrid_part
!>             (§15.16, Stage a).
!>   Step 0b   dest_oct_per_cell / dest_icell_per_cell precompute, one
!>             hash_get per (source_cell, k) entry (§15.18, Stage b).
!>   Step 0c   GPU multipole_q reduction at ilevel == levelmin (§15.20,
!>             Stage d) — replaces the prior serial host loop which read
!>             stale host mp/xp when data_on_device=.true.
!>   Deposit   Per-cell segmented reduction (cic_weight_kernel +
!>             cic_block_reduce_kernel per outer k = 1..threetondim).
!>             No global atomics on rho/nref.
subroutine gpu_cic_part_segmented(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, num_parts, leading, num_grids, total_cells
  integer(kind=4) :: total_dest_entries, total_sum_unused
  integer :: num_threads, num_blocks, k, idim
  integer :: deposit_block_size, deposit_num_blocks
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3
  real(kind=8) :: q_host(1:ndim+1)

  call nvtxStartRange("gpu_cic_part_segmented", color=4) ! purple

  if (rtype /= 0 .and. rtype /= 1) then
     call nvtxEndRange()
     return
  endif
  if (.not. allocated(xp)) then
     call nvtxEndRange()
     return
  endif

  ! Step 0c (§15.20): GPU multipole_q reduction at the coarsest active level.
  ! Slice is [1, sim%p%npart] to match host semantics in cic_part.
  if (ilevel == sim%r%levelmin .and. sim%p%npart > 0) then
     leading = size(xp, 1)
     multipole_q_dev = 0d0
     num_threads = 256
     num_blocks  = (sim%p%npart + num_threads - 1) / num_threads
     call multipole_q_kernel<<<num_blocks, num_threads>>>(xp, mp, multipole_q_dev, &
          sim%p%npart, leading)
     call GPU_Error_Check("gpu/gpu_part.cuf", 0)
     q_host = multipole_q_dev
     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_host(idim)
     end do
  endif

  head_idx  = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(sim%r%nlevelmax) - head_idx + 1
  if (num_parts <= 0) then
     call nvtxEndRange()
     return
  endif

  leading = size(xp, 1)
  dx_loc  = sim%r%boxlen / 2d0**ilevel
  vol_loc = dx_loc**ndim
  skip1 = 0d0
  skip2 = 0d0
  skip3 = 0d0
  if (ndim >= 1) skip1 = sim%m%skip(1)
  if (ndim >= 2) skip2 = sim%m%skip(2)
  if (ndim >= 3) skip3 = sim%m%skip(3)

  num_grids   = size(cell_part_count, 2)
  total_cells = twotondim * num_grids

  ! ============================================================
  ! §15.16 Step 0 — build cell-list at level (ilevel+1) (Stage a)
  ! ============================================================

  num_threads = 256
  num_blocks  = (total_cells + num_threads - 1) / num_threads
  call reset_cell_part_count_kernel<<<num_blocks, num_threads>>>(cell_part_count, num_grids)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads
  call build_cell_part_count_kernel<<<num_blocks, num_threads>>>(xp, &
       cell_part_count, src_icell_part, src_igrid_part, &
       hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, leading)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  call ensure_scan_capacity_part(total_cells)

  num_threads = 256
  num_blocks  = (total_cells + num_threads - 1) / num_threads
  call flatten_cell_count_kernel<<<num_blocks, num_threads>>>(cell_part_count, &
       prefix_sum, num_grids)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  call gpu_scan(1, total_cells, total_sum_unused)

  call compute_cell_part_head_kernel<<<num_blocks, num_threads>>>(cell_part_count, &
       cell_part_head, prefix_sum, num_grids)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads
  call place_cell_part_idx_kernel<<<num_blocks, num_threads>>>(cell_part_count, &
       cell_part_head, cell_part_idx, src_icell_part, src_igrid_part, &
       head_idx, num_parts)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  ! ============================================================
  ! §15.16 Step 0b — precompute dest_oct_per_cell (Stage b)
  ! ============================================================

  total_dest_entries = threetondim * total_cells
  num_threads = 256
  num_blocks  = (total_dest_entries + num_threads - 1) / num_threads
  call build_dest_oct_per_cell_kernel<<<num_blocks, num_threads>>>(grid, &
       cell_part_count, dest_oct_per_cell, dest_icell_per_cell, &
       hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       box_ckey_min, box_ckey_max, periodic, ilevel, num_grids)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  ! ============================================================
  ! §15.16 Steps 1+2+3 — segmented deposit. One block per source
  ! cell, outer loop k = 1..threetondim. NO global atomics on rho
  ! / nref: within iteration k, distinct source cells map to
  ! distinct destinations (lattice bijection mod periodic wrap);
  ! the threetondim outer iterations are serialized by the host.
  ! ============================================================

  deposit_block_size = 256
  deposit_num_blocks = total_cells
  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads
  do k = 1, threetondim
     call cic_weight_kernel<<<num_blocks, num_threads>>>(xp, mp, &
          src_icell_part, src_igrid_part, dest_oct_per_cell, &
          weight_part_rho, weight_part_nref, &
          skip1, skip2, skip3, dx_loc, vol_loc, &
          sim%r%m_refine(ilevel), sim%r%mass_cut_refine, &
          k, head_idx, num_parts, leading)
     call cic_block_reduce_kernel<<<deposit_num_blocks, deposit_block_size>>>(&
          cell_part_count, cell_part_head, cell_part_idx, &
          dest_oct_per_cell, dest_icell_per_cell, &
          weight_part_rho, weight_part_nref, rho, nref, &
          sim%r%m_refine(ilevel), k, num_grids)
  end do
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  call nvtxEndRange()
end subroutine gpu_cic_part_segmented
!> Kick/drift: CIC gather from f, optional fp, position update.
attributes(device) subroutine analytic_gravity_part(x, ff, dx_loc, gravity_type, &
     gp1, gp2, gp3, gp4, gp5, q1, q2, q3, q4)
  real(kind=8) :: x(1:3), ff(1:3)
  real(kind=8), intent(in), value :: dx_loc
  integer(kind=4), intent(in), value :: gravity_type
  real(kind=8), intent(in), value :: gp1, gp2, gp3, gp4, gp5
  real(kind=8), intent(in), value :: q1, q2, q3, q4

  real(kind=8) :: gmass, emass, xmass, ymass, zmass
  real(kind=8) :: rx, ry, rz, rr

  ff = 0d0

  if (gravity_type == 0) then
     rx = x(1) - q2 / q1
     ry = 0d0
     rz = 0d0
     if (ndim >= 2) ry = x(2) - q3 / q1
     if (ndim >= 3) rz = x(3) - q4 / q1
     rr = max(sqrt(rx**2 + ry**2 + rz**2), dx_loc)
     if (ndim == 1) then
        ff(1) = -q1 * 2d0 * acos(-1d0) * rx / rr
     else if (ndim == 2) then
        ff(1) = -q1 * 2d0 * rx / rr**2
        ff(2) = -q1 * 2d0 * ry / rr**2
     else
        ff(1) = -q1 * rx / rr**3
        ff(2) = -q1 * ry / rr**3
        ff(3) = -q1 * rz / rr**3
     endif
  else if (gravity_type == 1) then
     ff(1) = gp1
     if (ndim >= 2) ff(2) = gp2
     if (ndim >= 3) ff(3) = gp3
  else if (gravity_type == 2) then
     gmass = gp1
     emass = gp2
     xmass = gp3
     ymass = gp4
     zmass = gp5
     rx = x(1) - xmass
     ry = 0d0
     rz = 0d0
     if (ndim >= 2) ry = x(2) - ymass
     if (ndim >= 3) rz = x(3) - zmass
     rr = sqrt(rx**2 + ry**2 + rz**2 + emass**2)
     if (ndim == 1) then
        ff(1) = -gmass * rx / rr
     else if (ndim == 2) then
        ff(1) = -gmass * ry / rr**2
        ff(2) = -gmass * ry / rr**2
     else
        ff(1) = -gmass * rx / rr**3
        ff(2) = -gmass * ry / rr**3
        ff(3) = -gmass * rz / rr**3
     endif
  endif
end subroutine analytic_gravity_part

attributes(device) subroutine gather_cic_force_part(f_d, hash_key_d, hash_val_d, &
     hash_size_d, ckey_max_d, key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, &
     x_in, cell_level, grid_level, ff, ok_level, &
     dbg_capture_in, igrid_out, icell_out, vol_out, fc_out)
  real(kind=dp),   device :: f_d(1:twotondim,1:ndim,*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3,*)
  integer(kind=4), device :: box_ckey_max_d(1:3,*)
  logical,         device :: periodic_d(1:3)
  real(kind=8) :: x_in(1:3), ff(1:3)
  integer(kind=4), intent(in), value :: cell_level, grid_level
  logical :: ok_level
  ! Debug capture (per-corner gather state). Writes are gated on
  ! dbg_capture_in /= 0 so the non-capture path adds only a value-arg load and
  ! a single predicated branch per corner — no per-corner output stores.
  ! Out shape matches CPU `cic_index`/`cic_weight` ordering
  ! (ind = 1 + bx + 2*by + 4*bz; see pm/rho_fine.f90:1631-1684).
  integer(kind=4), intent(in), value :: dbg_capture_in
  integer(kind=4) :: igrid_out(1:twotondim)
  integer(kind=4) :: icell_out(1:twotondim)
  real(kind=8)    :: vol_out(1:twotondim)
  real(kind=8)    :: fc_out(1:twotondim, 1:ndim)

  integer :: idim, bx, by, bz, igrid, icell, ind
  integer(kind=4) :: il(1:3), ir(1:3), target_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=4) :: box_min(1:3), box_max(1:3)
  integer(kind=8) :: nx, offset, key, ix8, iy8, iz8
  real(kind=8) :: dr(1:3), dl(1:3), weight
  logical :: in_domain

  ok_level = .true.
  ff = 0d0
  if (dbg_capture_in /= 0) then
     igrid_out = 0
     icell_out = 0
     vol_out = 0d0
     fc_out = 0d0
  endif
  if (grid_level < 1) then
     ok_level = .false.
     return
  endif

  il = 0
  ir = 0
  dr = 0d0
  dl = 1d0
  box_min = 0
  box_max = 0
  do idim = 1, ndim
     dr(idim) = x_in(idim) + 0.5d0
     ir(idim) = int(dr(idim))
     dr(idim) = dr(idim) - ir(idim)
     dl(idim) = 1d0 - dr(idim)
     il(idim) = ir(idim) - 1
     box_min(idim) = box_ckey_min_d(idim, cell_level)
     box_max(idim) = box_ckey_max_d(idim, cell_level)
     if (periodic_d(idim)) then
        if (il(idim) < box_min(idim))  il(idim) = box_max(idim) - 1
        if (ir(idim) >= box_max(idim)) ir(idim) = box_min(idim)
     endif
  end do

  do bz = 0, 1
     if (ndim < 3 .and. bz == 1) cycle
     do by = 0, 1
        if (ndim < 2 .and. by == 1) cycle
        do bx = 0, 1
           target_ckey = 0
           target_ckey(1) = merge(ir(1), il(1), bx == 1)
           weight = merge(dr(1), dl(1), bx == 1)
           if (ndim >= 2) then
              target_ckey(2) = merge(ir(2), il(2), by == 1)
              weight = weight * merge(dr(2), dl(2), by == 1)
           endif
           if (ndim >= 3) then
              target_ckey(3) = merge(ir(3), il(3), bz == 1)
              weight = weight * merge(dr(3), dl(3), bz == 1)
           endif

           ind = 1 + bx
           if (ndim >= 2) ind = ind + 2*by
           if (ndim >= 3) ind = ind + 4*bz
           if (dbg_capture_in /= 0) vol_out(ind) = weight

           in_domain = .true.
           do idim = 1, ndim
              if (.not. periodic_d(idim)) then
                 if (target_ckey(idim) < box_min(idim))  in_domain = .false.
                 if (target_ckey(idim) >= box_max(idim)) in_domain = .false.
              endif
           end do
           if (.not. in_domain) then
              ok_level = .false.
              cycle
           endif

           father_ckey = target_ckey / 2
           ii = target_ckey - 2 * father_ckey
           icell = 1
           do idim = 1, ndim
              icell = icell + ii(idim) * (2**(idim-1))
           end do
           if (dbg_capture_in /= 0) icell_out(ind) = icell

           ix8 = int(father_ckey(1), kind=8)
           iy8 = int(father_ckey(2), kind=8)
           iz8 = int(father_ckey(3), kind=8)
           nx  = int(ckey_max_d(grid_level), kind=8)
           offset = key_off_d(grid_level)
           key = offset + ix8 + iy8*nx + iz8*nx*nx
           igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
           if (igrid == 0) then
              ok_level = .false.
              cycle
           endif
           if (dbg_capture_in /= 0) igrid_out(ind) = igrid

           do idim = 1, ndim
              ff(idim) = ff(idim) + real(f_d(icell, idim, igrid), kind=8) * weight
              if (dbg_capture_in /= 0) fc_out(ind, idim) = real(f_d(icell, idim, igrid), kind=8)
           end do
        end do
     end do
  end do

  if (.not. ok_level) ff = 0d0
end subroutine gather_cic_force_part

attributes(global) subroutine static_levelp_part_kernel(levelp_d, ilevel, head_idx, num_parts)
  integer(kind=4), device :: levelp_d(*)
  integer(kind=4), intent(in), value :: ilevel
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return

  ipart = head_idx + idx
  levelp_d(ipart) = ilevel
end subroutine static_levelp_part_kernel

attributes(global) subroutine gravana_preloop_part_kernel(xp_d, vp_d, levelp_d, &
     dtnew_d, dx_loc, action_part, ilevel, head_idx, num_parts, leading, &
     gravity_type, gp1, gp2, gp3, gp4, gp5, q1, q2, q3, q4)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: vp_d(*)
  integer(kind=4), device :: levelp_d(*)
  real(kind=8),    device :: dtnew_d(*)
  real(kind=8), intent(in), value :: dx_loc
  integer(kind=4), intent(in), value :: action_part
  integer(kind=4), intent(in), value :: ilevel
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: gravity_type
  real(kind=8), intent(in), value :: gp1, gp2, gp3, gp4, gp5
  real(kind=8), intent(in), value :: q1, q2, q3, q4

  integer :: thread_idx, block_idx, idx, ipart, idim, lp
  real(kind=8) :: x(1:3), ff(1:3), xnew, dteff

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return

  ipart = head_idx + idx
  x = 0d0
  do idim = 1, ndim
     x(idim) = xp_d(ipart + (idim-1)*leading)
  end do

  call analytic_gravity_part(x, ff, dx_loc, gravity_type, &
       gp1, gp2, gp3, gp4, gp5, q1, q2, q3, q4)

  if (action_part == 2) then
     do idim = 1, ndim
        vp_d(ipart + (idim-1)*leading) = vp_d(ipart + (idim-1)*leading) &
             + ff(idim) * 0.5d0 * dtnew_d(ilevel)
        xnew = xp_d(ipart + (idim-1)*leading) &
             + vp_d(ipart + (idim-1)*leading) * dtnew_d(ilevel)
        xp_d(ipart + (idim-1)*leading) = xnew
     end do
  else if (action_part == 1) then
     lp = levelp_d(ipart)
     dteff = dtnew_d(lp)
     levelp_d(ipart) = ilevel
     do idim = 1, ndim
        vp_d(ipart + (idim-1)*leading) = vp_d(ipart + (idim-1)*leading) &
             + ff(idim) * 0.5d0 * dteff
     end do
  endif
end subroutine gravana_preloop_part_kernel

attributes(global) subroutine kick_drift_part_kernel(xp_d, vp_d, fp_d, levelp_d, f_d, &
     hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     box_ckey_min_d, box_ckey_max_d, box_size_d, periodic_d, &
     dtnew_d, dtold_d, skip1, skip2, skip3, dx_loc, &
     action_part, ilevel, head_idx, num_parts, leading, has_fp, &
     idp_d, dbg_capture, dbg_idp_lo, dbg_idp_hi, ndbg_max, &
     dbg_count_d, dbg_idp_d, dbg_ok_fine_d, dbg_ok_coarse_d, dbg_used_coarse_d, &
     dbg_igrid_d, dbg_icell_d, dbg_vol_d, dbg_fc_d)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: vp_d(*)
  real(kind=dp),   device :: fp_d(*)
  integer(kind=4), device :: levelp_d(*)
  real(kind=dp),   device :: f_d(1:twotondim,1:ndim,*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3,*)
  integer(kind=4), device :: box_ckey_max_d(1:3,*)
  real(kind=8),    device :: box_size_d(1:3)
  logical,         device :: periodic_d(1:3)
  real(kind=8),    device :: dtnew_d(*)
  real(kind=8),    device :: dtold_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3, dx_loc
  integer(kind=4), intent(in), value :: action_part
  integer(kind=4), intent(in), value :: ilevel
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: has_fp
  ! Per-slot gather-state probe (cluster band only; no control-flow effect).
  integer(i8b),    device :: idp_d(*)
  integer(kind=4), intent(in), value :: dbg_capture
  integer(i8b),    intent(in), value :: dbg_idp_lo, dbg_idp_hi
  integer(kind=4), intent(in), value :: ndbg_max
  integer(kind=4), device :: dbg_count_d(*)
  integer(i8b),    device :: dbg_idp_d(*)
  integer(kind=4), device :: dbg_ok_fine_d(*)
  integer(kind=4), device :: dbg_ok_coarse_d(*)
  integer(kind=4), device :: dbg_used_coarse_d(*)
  integer(kind=4), device :: dbg_igrid_d(1:twotondim, *)
  integer(kind=4), device :: dbg_icell_d(1:twotondim, *)
  real(kind=8),    device :: dbg_vol_d(1:twotondim, *)
  real(kind=8),    device :: dbg_fc_d(1:twotondim, 1:ndim, *)

  integer :: thread_idx, block_idx, idx, ipart, idim, lp, ind, slot, info
  real(kind=8) :: skip(1:3), x(1:3), x_coarse(1:3), ff(1:3)
  real(kind=8) :: dteff, xnew
  logical :: ok_level, ok_fine, ok_coarse, used_coarse
  ! Per-corner gather state for capture (filled by gather_cic_force_part).
  integer(kind=4) :: igrid_used(1:twotondim)
  integer(kind=4) :: icell_used(1:twotondim)
  real(kind=8)    :: vol_used(1:twotondim)
  real(kind=8)    :: fc_used(1:twotondim, 1:ndim)
  integer(i8b)    :: my_idp

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return

  ipart = head_idx + idx
  ff = 0d0

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  x = 0d0
  do idim = 1, ndim
     x(idim) = (xp_d(ipart + (idim-1)*leading) + skip(idim)) / dx_loc
  end do

  call gather_cic_force_part(f_d, hash_key_d, hash_val_d, hash_size_d, ckey_max_d, &
       key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, x, ilevel+1, ilevel, &
       ff, ok_level, dbg_capture, igrid_used, icell_used, vol_used, fc_used)
  ok_fine = ok_level
  ok_coarse = .false.
  used_coarse = .false.

  if (.not. ok_level) then
     used_coarse = .true.
     x_coarse = x / 2d0
     call gather_cic_force_part(f_d, hash_key_d, hash_val_d, hash_size_d, ckey_max_d, &
          key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, x_coarse, ilevel, ilevel-1, &
          ff, ok_level, dbg_capture, igrid_used, icell_used, vol_used, fc_used)
     ok_coarse = ok_level
  endif

  ! Per-slot gather-state capture. No control-flow effect on integration;
  ! only writes to pre-allocated debug scratch when (idp, dbg flag) match.
  if (dbg_capture /= 0) then
     my_idp = idp_d(ipart)
     if (my_idp >= dbg_idp_lo .and. my_idp <= dbg_idp_hi) then
        info = atomicadd(dbg_count_d(1), 1)
        slot = info + 1
        if (slot <= ndbg_max) then
           dbg_idp_d(slot) = my_idp
           dbg_ok_fine_d(slot) = merge(1, 0, ok_fine)
           dbg_ok_coarse_d(slot) = merge(1, 0, ok_coarse)
           dbg_used_coarse_d(slot) = merge(1, 0, used_coarse)
           do ind = 1, twotondim
              dbg_igrid_d(ind, slot) = igrid_used(ind)
              dbg_icell_d(ind, slot) = icell_used(ind)
              dbg_vol_d(ind, slot) = vol_used(ind)
              do idim = 1, ndim
                 dbg_fc_d(ind, idim, slot) = fc_used(ind, idim)
              end do
           end do
        endif
     endif
  endif

  if (has_fp /= 0 .and. ok_level) then
     do idim = 1, ndim
        fp_d(ipart + (idim-1)*leading) = ff(idim)
     end do
  endif

  if (action_part == 2) then
     do idim = 1, ndim
        vp_d(ipart + (idim-1)*leading) = vp_d(ipart + (idim-1)*leading) &
             + ff(idim) * 0.5d0 * dtnew_d(ilevel)
        xnew = xp_d(ipart + (idim-1)*leading) &
             + vp_d(ipart + (idim-1)*leading) * dtnew_d(ilevel)
        if (periodic_d(idim)) then
           if (xnew < 0d0)              xnew = xnew + box_size_d(idim)
           if (xnew >= box_size_d(idim)) xnew = xnew - box_size_d(idim)
        endif
        xp_d(ipart + (idim-1)*leading) = xnew
     end do
  else if (action_part == 1) then
     lp = levelp_d(ipart)
     if (lp >= ilevel) then
        dteff = dtnew_d(lp)
     else
        dteff = dtold_d(lp)
     endif
     levelp_d(ipart) = ilevel
     do idim = 1, ndim
        vp_d(ipart + (idim-1)*leading) = vp_d(ipart + (idim-1)*leading) &
             + ff(idim) * 0.5d0 * dteff
     end do
  endif
end subroutine kick_drift_part_kernel

subroutine gpu_kick_drift_part(sim, ilevel, action_part)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: action_part

  integer(kind=4) :: head_idx, num_parts, head_coarse, num_coarse, leading
  integer :: num_threads, num_blocks
  real(kind=8) :: dx_loc, skip1, skip2, skip3
  real(kind=8) :: gp1, gp2, gp3, gp4, gp5, q1, q2, q3, q4
  integer(kind=4) :: gravity_type
  logical :: any_nonperiodic, debug_kick

  ! Per-slot gather-state probe scratch. Lives across kick fires (save);
  ! capacity NDBG_KICK slots; cluster band [DBG_IDP_LO, DBG_IDP_HI] mirrors
  ! the existing dump_kick_window_part idp filter. Allocated once on first
  ! entry; reused thereafter; count reset to 0 before each capturing launch.
  integer(kind=4), parameter :: NDBG_KICK = 8
  integer(i8b),    parameter :: DBG_IDP_LO = 1007296_i8b, DBG_IDP_HI = 1007426_i8b
  integer(kind=4), device, allocatable, save :: dbg_count_d(:)
  integer(i8b),    device, allocatable, save :: dbg_idp_d(:)
  integer(kind=4), device, allocatable, save :: dbg_ok_fine_d(:)
  integer(kind=4), device, allocatable, save :: dbg_ok_coarse_d(:)
  integer(kind=4), device, allocatable, save :: dbg_used_coarse_d(:)
  integer(kind=4), device, allocatable, save :: dbg_igrid_d(:,:)
  integer(kind=4), device, allocatable, save :: dbg_icell_d(:,:)
  real(kind=8),    device, allocatable, save :: dbg_vol_d(:,:)
  real(kind=8),    device, allocatable, save :: dbg_fc_d(:,:,:)
  integer(kind=4) :: dbg_capture
  integer(kind=4) :: dbg_count_h
  integer(kind=4) :: dbg_count_buf(1:1)
  integer(i8b)    :: dbg_idp_h(1:NDBG_KICK)
  integer(kind=4) :: dbg_ok_fine_h(1:NDBG_KICK)
  integer(kind=4) :: dbg_ok_coarse_h(1:NDBG_KICK)
  integer(kind=4) :: dbg_used_coarse_h(1:NDBG_KICK)
  integer(kind=4) :: dbg_igrid_h(1:twotondim, 1:NDBG_KICK)
  integer(kind=4) :: dbg_icell_h(1:twotondim, 1:NDBG_KICK)
  real(kind=8)    :: dbg_vol_h(1:twotondim, 1:NDBG_KICK)
  real(kind=8)    :: dbg_fc_h(1:twotondim, 1:ndim, 1:NDBG_KICK)
  integer(kind=4) :: dbg_slot, dbg_ind, n_print

  call nvtxStartRange("gpu_kick_drift_part", color=4) ! purple

  ! Allocate the gather-state probe scratch once (small: ~3 KB total).
  ! Always-allocated keeps kernel device pointers valid; capture is gated by
  ! dbg_capture argument so the scratch is touched only on the dump path.
  if (.not. allocated(dbg_count_d))      allocate(dbg_count_d(1:1))
  if (.not. allocated(dbg_idp_d))        allocate(dbg_idp_d(1:NDBG_KICK))
  if (.not. allocated(dbg_ok_fine_d))    allocate(dbg_ok_fine_d(1:NDBG_KICK))
  if (.not. allocated(dbg_ok_coarse_d))  allocate(dbg_ok_coarse_d(1:NDBG_KICK))
  if (.not. allocated(dbg_used_coarse_d))allocate(dbg_used_coarse_d(1:NDBG_KICK))
  if (.not. allocated(dbg_igrid_d))      allocate(dbg_igrid_d(1:twotondim, 1:NDBG_KICK))
  if (.not. allocated(dbg_icell_d))      allocate(dbg_icell_d(1:twotondim, 1:NDBG_KICK))
  if (.not. allocated(dbg_vol_d))        allocate(dbg_vol_d(1:twotondim, 1:NDBG_KICK))
  if (.not. allocated(dbg_fc_d))         allocate(dbg_fc_d(1:twotondim, 1:ndim, 1:NDBG_KICK))

  if (.not. allocated(xp)) then
     call nvtxEndRange()
     return
  endif
  leading = size(xp, 1)
  dx_loc = sim%r%boxlen / 2d0**ilevel
  skip1 = 0d0
  skip2 = 0d0
  skip3 = 0d0
  if (ndim >= 1) skip1 = sim%m%skip(1)
  if (ndim >= 2) skip2 = sim%m%skip(2)
  if (ndim >= 3) skip3 = sim%m%skip(3)
  debug_kick = sim%r%verbose .and. gpu_part_env_flag('GPU_PART_DEBUG_KICK')
  dtnew_part = sim%g%dtnew
  dtold_part = sim%g%dtold
  num_threads = 128

  head_idx  = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(ilevel) - head_idx + 1

  if (sim%p%static) then
     if (num_parts > 0) then
        num_blocks  = (num_parts + num_threads - 1) / num_threads
        call static_levelp_part_kernel<<<num_blocks, num_threads>>>(levelp, ilevel, head_idx, num_parts)
        call GPU_Error_Check("gpu/gpu_part.cuf", 0)
     endif
     call nvtxEndRange()
     return
  endif

  any_nonperiodic = any(.not. sim%r%periodic(1:ndim))
  if (ilevel == sim%r%levelmin .and. any_nonperiodic) then
     head_coarse = sim%p%headp(ilevel-1)
     num_coarse = sim%p%tailp(ilevel-1) - head_coarse + 1
     if (num_coarse > 0) then
        gp1 = sim%r%gravity_params(1)
        gp2 = sim%r%gravity_params(2)
        gp3 = sim%r%gravity_params(3)
        gp4 = sim%r%gravity_params(4)
        gp5 = sim%r%gravity_params(5)
        q1 = sim%g%multipole%q(1)
        q2 = sim%g%multipole%q(2)
        q3 = 0d0
        q4 = 0d0
        if (ndim >= 2) q3 = sim%g%multipole%q(3)
        if (ndim >= 3) q4 = sim%g%multipole%q(4)
        gravity_type = sim%r%gravity_type
        num_blocks = (num_coarse + num_threads - 1) / num_threads
        call gravana_preloop_part_kernel<<<num_blocks, num_threads>>>(xp, vp, levelp, &
             dtnew_part, dx_loc, action_part, ilevel, head_coarse, num_coarse, leading, &
             gravity_type, gp1, gp2, gp3, gp4, gp5, q1, q2, q3, q4)
        call GPU_Error_Check("gpu/gpu_part.cuf", 0)
     endif
  endif

  if (num_parts <= 0) then
     call nvtxEndRange()
     return
  endif
  if (.not. allocated(f)) then
     call nvtxEndRange()
     return
  endif

  ! Analytic gravity: copy host f to device before kick.
  if (sim%r%gravity_type > 0) then
     f = sim%m%f
     call GPU_Error_Check("gpu/gpu_part.cuf", 0)
  endif
  num_blocks  = (num_parts + num_threads - 1) / num_threads
  if (debug_kick) then
     write(*,'(A,I0,A,I0,A,I0,A,I0,A,I0,A,I0,A,I0,A,I0,A,1PE15.8,A,1PE15.8,A,I0,A,L1)') &
          ' gpu_kick_drift_part: action=', action_part, &
          ' ilevel=', ilevel, &
          ' head_idx=', head_idx, ' num_parts=', num_parts, &
          ' m%head(L)=', sim%m%head(ilevel), ' m%noct(L)=', sim%m%noct(ilevel), &
          ' m%head(L+1)=', sim%m%head(min(ilevel+1, sim%r%nlevelmax)), &
          ' m%noct(L+1)=', sim%m%noct(min(ilevel+1, sim%r%nlevelmax)), &
          ' dtnew(L)=', sim%g%dtnew(ilevel), &
          ' dtold(L)=', sim%g%dtold(ilevel), &
          ' has_fp=', merge(1, 0, allocated(fp)), &
          ' allocated_fp=', allocated(fp)
  endif
  ! Gather-state probe gate: same as existing dump_kick_window_part — only
  ! capture on the first lev8 kickonly fire targeted by triage 2026-05-20.
  dbg_capture = 0
  if (debug_kick .and. ilevel == 8 .and. action_part == 1) then
     dbg_capture = 1
     dbg_count_buf(1) = 0
     dbg_count_d = dbg_count_buf
  endif

  if (allocated(fp)) then
     call kick_drift_part_kernel<<<num_blocks, num_threads>>>(xp, vp, fp, levelp, f, &
          hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          box_ckey_min, box_ckey_max, box_size, periodic, dtnew_part, dtold_part, &
          skip1, skip2, skip3, dx_loc, action_part, ilevel, head_idx, num_parts, leading, 1, &
          idp, dbg_capture, DBG_IDP_LO, DBG_IDP_HI, NDBG_KICK, &
          dbg_count_d, dbg_idp_d, dbg_ok_fine_d, dbg_ok_coarse_d, dbg_used_coarse_d, &
          dbg_igrid_d, dbg_icell_d, dbg_vol_d, dbg_fc_d)
  else
     if (.not. allocated(fp_dummy)) allocate(fp_dummy(1))
     call kick_drift_part_kernel<<<num_blocks, num_threads>>>(xp, vp, fp_dummy, levelp, f, &
          hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          box_ckey_min, box_ckey_max, box_size, periodic, dtnew_part, dtold_part, &
          skip1, skip2, skip3, dx_loc, action_part, ilevel, head_idx, num_parts, leading, 0, &
          idp, dbg_capture, DBG_IDP_LO, DBG_IDP_HI, NDBG_KICK, &
          dbg_count_d, dbg_idp_d, dbg_ok_fine_d, dbg_ok_coarse_d, dbg_used_coarse_d, &
          dbg_igrid_d, dbg_icell_d, dbg_vol_d, dbg_fc_d)
  endif
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  ! Per-slot kick window dump (Lev8 kick localization, first cluster from 315868).
  ! GPU_Error_Check above issues cudaDeviceSynchronize; fp / xp / vp / levelp
  ! are safe to read from host via implicit device-to-host slice copy.
  if (debug_kick .and. ilevel == 8 .and. action_part == 1) then
     if (allocated(fp)) then
        call dump_kick_window_part("after_kernel", head_idx, num_parts, ilevel, action_part, 1)
     else
        call dump_kick_window_part("after_kernel", head_idx, num_parts, ilevel, action_part, 0)
     endif

     ! Per-slot gather-state dump: pull captured fields to host, emit one
     ! `kick_gather_dump:` line per claimed slot. CPU mirror is in
     ! pm/move_fine.f90 cic_kick_drift_part under the same idp filter.
     dbg_count_buf = dbg_count_d
     dbg_count_h = dbg_count_buf(1)
     n_print = min(dbg_count_h, NDBG_KICK)
     if (n_print > 0) then
        dbg_idp_h(1:n_print)         = dbg_idp_d(1:n_print)
        dbg_ok_fine_h(1:n_print)     = dbg_ok_fine_d(1:n_print)
        dbg_ok_coarse_h(1:n_print)   = dbg_ok_coarse_d(1:n_print)
        dbg_used_coarse_h(1:n_print) = dbg_used_coarse_d(1:n_print)
        dbg_igrid_h(1:twotondim, 1:n_print) = dbg_igrid_d(1:twotondim, 1:n_print)
        dbg_icell_h(1:twotondim, 1:n_print) = dbg_icell_d(1:twotondim, 1:n_print)
        dbg_vol_h(1:twotondim, 1:n_print)   = dbg_vol_d(1:twotondim, 1:n_print)
        dbg_fc_h(1:twotondim, 1:ndim, 1:n_print) = dbg_fc_d(1:twotondim, 1:ndim, 1:n_print)
     endif
     do dbg_slot = 1, n_print
        if (ndim == 3) then
           write(*,'(A,I0,A,I0,A,I0,A,I0,A,I0,A,8(1X,I0),A,8(1X,I0),A,8(1X,ES15.7),A,8(1X,ES15.7),A,8(1X,ES15.7),A,8(1X,ES15.7))') &
                ' kick_gather_dump: slot=', dbg_slot, &
                ' idp=', int(dbg_idp_h(dbg_slot), kind=8), &
                ' ok_fine=', dbg_ok_fine_h(dbg_slot), &
                ' ok_coarse=', dbg_ok_coarse_h(dbg_slot), &
                ' used_coarse=', dbg_used_coarse_h(dbg_slot), &
                ' igrid=', (dbg_igrid_h(dbg_ind, dbg_slot), dbg_ind=1,twotondim), &
                ' icell=', (dbg_icell_h(dbg_ind, dbg_slot), dbg_ind=1,twotondim), &
                ' vol=',   (dbg_vol_h(dbg_ind, dbg_slot),   dbg_ind=1,twotondim), &
                ' f0=',    (dbg_fc_h(dbg_ind, 1, dbg_slot), dbg_ind=1,twotondim), &
                ' f1=',    (dbg_fc_h(dbg_ind, 2, dbg_slot), dbg_ind=1,twotondim), &
                ' f2=',    (dbg_fc_h(dbg_ind, 3, dbg_slot), dbg_ind=1,twotondim)
        else
           write(*,'(A,I0,A,I0,A,I0,A,I0,A,I0)') &
                ' kick_gather_dump: slot=', dbg_slot, &
                ' idp=', int(dbg_idp_h(dbg_slot), kind=8), &
                ' ok_fine=', dbg_ok_fine_h(dbg_slot), &
                ' ok_coarse=', dbg_ok_coarse_h(dbg_slot), &
                ' used_coarse=', dbg_used_coarse_h(dbg_slot)
        endif
     end do
  endif

  call nvtxEndRange()
end subroutine gpu_kick_drift_part
