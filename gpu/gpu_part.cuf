!> Particle kernels and dispatchers (included from gpu_runner).
!> Rank-2 arrays use layout (npart_max, ndim); gather/scatter use flat
!> indices with `leading` = size(xp,1), not npart_max.
!>
!> Rank-2 arrays (xp, vp, fp, jp) are gathered/scattered as ndim independent
!> rank-1 columns via `sort_gather_part_real_col` /
!> `sort_scatter_part_real_col`.
!>
!> CIC deposition is gated while isolating run 315264. Default is the
!> pre-segmented global-atomic path; set GPU_CIC_SEGMENTED=1 to exercise
!> the §15.16 per-cell segmented-reduction path.

logical function gpu_part_env_flag(name)
  character(len=*), intent(in) :: name
  character(len=32) :: value
  integer :: status, length

  value = ''
  call get_environment_variable(name, value, length, status)
  gpu_part_env_flag = .false.
  if (status /= 0) return

  select case (trim(adjustl(value)))
  case ('1', 'y', 'Y', 'yes', 'YES', 'true', 'TRUE', 'on', 'ON')
     gpu_part_env_flag = .true.
  end select
end function gpu_part_env_flag

!> Bucket 0/1 for ilevel == levelmin-1 (domain test).
attributes(global) subroutine bucket_part_boundary(xp, bucket_part, &
     box_size_d, periodic_d, head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp), device :: xp(*)
  integer(kind=4), device :: bucket_part(*)
  real(kind=8), device :: box_size_d(1:3)
  logical, device :: periodic_d(1:3)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart, idim
  logical :: in_domain
  real(kind=8) :: x_idim

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  in_domain = .true.
  do idim = 1, ndim
     if (.not. periodic_d(idim)) then
        x_idim = xp(ipart + (idim-1)*leading)
        if (x_idim < 0d0 .or. x_idim >= box_size_d(idim)) in_domain = .false.
     endif
  end do

  if (in_domain) then
     bucket_part(ipart) = 1   ! fine: stays at finer level
  else
     bucket_part(ipart) = 0   ! coarse: out-of-box, demoted
  endif
end subroutine bucket_part_boundary

!> Bucket 0/1 from hash lookup and leaf/refined test.
attributes(global) subroutine bucket_part_general(xp, bucket_part, &
     grid, hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, leading)
  ! hash_get: same compilation unit as gpu_runner (nordc).
  integer(kind=4), intent(in), value :: leading
  real(kind=dp), device :: xp(*)
  integer(kind=4), device :: bucket_part(*)
  type(oct), device :: grid(*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3
  real(kind=8), intent(in), value :: dx_loc
  integer(kind=4), intent(in), value :: ilevel
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart, idim, igrid, icell
  integer(kind=4) :: ix(1:3), ii(1:3)
  integer(kind=8) :: ix8, iy8, iz8, nx, offset, key
  real(kind=8) :: skip(1:3), x(1:3), xs, inv_dx_loc, inv_2dx_loc

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3
  inv_dx_loc  = 1d0 / dx_loc
  inv_2dx_loc = 0.5d0 * inv_dx_loc

  ix = 0
  do idim = 1, ndim
     xs = xp(ipart + (idim-1)*leading) + skip(idim)
     ix(idim) = floor(xs * inv_2dx_loc)
  end do

  ! Build Cartesian-key encoding identical to insert_hash_kernel.
  ix8 = int(ix(1), kind=8)
  iy8 = int(ix(2), kind=8)
  iz8 = int(ix(3), kind=8)
  nx  = int(ckey_max_d(ilevel), kind=8)
  offset = key_off_d(ilevel)
  key = offset + ix8 + iy8*nx + iz8*nx*nx

  igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

  if (igrid == 0) then
     bucket_part(ipart) = 0    ! coarse: hash miss
     return
  endif

  ! Compute in-cell index inside the parent (igrid) oct.
  ! Runtime ndim loops (no #if in this included file).
  do idim = 1, ndim
     x(idim) = (xp(ipart + (idim-1)*leading) + skip(idim)) * inv_dx_loc
     ii(idim) = int(x(idim) - 2*ix(idim))
  end do
  icell = 1
  do idim = 1, ndim
     icell = icell + ii(idim) * (2**(idim-1))
  end do

  if (.not. grid(igrid)%refined(icell)) then
     bucket_part(ipart) = 0    ! coarse: leaf cell
  else
     bucket_part(ipart) = 1    ! fine: refined cell
  endif
end subroutine bucket_part_general

!> prefix_sum(idx) := bucket_part(idx) for stable 0/1 partition.
attributes(global) subroutine init_prefix_sum_part(bucket_part, prefix_sum_d, &
     head_idx, num_parts)
  integer(kind=4), device :: bucket_part(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  prefix_sum_d(idx) = bucket_part(idx)
end subroutine init_prefix_sum_part

!> prefix_sum(h) := 1 if Hilbert-rank-h's particle is COARSE, else 0.
!> Used by the Hilbert-order second pass that re-orders gpu_split_part's
!> coarse bucket to match CPU's intentional Hilbert ordering at
!> pm/rho_fine.f90:1416-1424. Read from sortp_d(h) (Hilbert-ranked
!> particle index produced by gpu_sort_part) and bucket_part_d (slot-keyed
!> 1=fine / 0=coarse marker set by bucket_part_general/boundary).
attributes(global) subroutine init_prefix_sum_part_hilbert_coarse( &
     bucket_part_d, sortp_d, prefix_sum_d, head_idx, num_parts)
  integer(kind=4), device :: bucket_part_d(*)
  integer(kind=4), device :: sortp_d(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  ipart = sortp_d(idx)
  prefix_sum_d(idx) = 1 - bucket_part_d(ipart)
end subroutine init_prefix_sum_part_hilbert_coarse

!> Overwrite swap_global's coarse range with Hilbert-ordered coarse particles.
!> Mirrors CPU split_part's "Loop over coarse level particles" at
!> pm/rho_fine.f90:1418-1426 (which assigns workp in sortp/Hilbert order).
!>
!> Pre-conditions:
!>   - swap_global_d(head:head+num_parts-1) already holds the slot-stable
!>     0/1 partition from the existing scan (coarse in [head, head+n_coarse-1],
!>     fine in [head+n_coarse, head+num_parts-1], both in slot order).
!>   - prefix_sum_d(h) for h in [head, head+num_parts-1] is the *inclusive*
!>     scan of (1 - bucket_part_d(sortp_d(h))) -> 1-based rank of coarse
!>     particles in Hilbert order at each Hilbert position h.
!>
!> Action: for each Hilbert position h, if bucket_part_d(sortp_d(h)) == 0
!> (coarse), overwrite swap_global_d(head + prefix_sum_d(h) - 1) = sortp_d(h).
!> Fine positions skip the write -- the fine range of swap_global is left
!> exactly as the slot-stable scan produced it (matches CPU's slot-order
!> fine loop at pm/rho_fine.f90:1408-1414).
!>
!> No race: each thread writes to a unique coarse slot in [head, head+n_coarse-1]
!> (uniqueness guaranteed by the inclusive scan being strictly monotonic on
!> the coarse subset). Reads of bucket_part_d / sortp_d / prefix_sum_d are
!> from arrays not written by this kernel.
attributes(global) subroutine write_swap_global_coarse_hilbert( &
     swap_global_d, bucket_part_d, sortp_d, prefix_sum_d, head_idx, num_parts)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), device :: bucket_part_d(*)
  integer(kind=4), device :: sortp_d(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart, coarse_rank
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  ipart = sortp_d(idx)
  if (bucket_part_d(ipart) == 0) then
     coarse_rank = prefix_sum_d(idx)
     swap_global_d(head_idx + coarse_rank - 1) = ipart
  endif
end subroutine write_swap_global_coarse_hilbert

!> Gather/scatter one column of a rank-2 real(dp) field.
!> `leading` = size(xp,1); `idim` selects the column (1..ndim).
!> One call per column — mirrors gpu_refine `sort_gather_force` idiom and
!> reuses the rank-1 thread mapping verbatim, only adding (idim-1)*leading
!> offsets to buf/src. The unified rank-2 kernel that looped over idim
!> inside the kernel was the source of the split-7-dump-14 bug.
attributes(global) subroutine sort_gather_part_real_col(buf, src, swap_global_d, &
     head_idx, num_parts, leading, idim)
  integer(kind=4), intent(in), value :: leading
  integer(kind=4), intent(in), value :: idim
  real(kind=dp), device :: buf(*)
  real(kind=dp), device :: src(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, old_idx, off
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  old_idx = swap_global_d(idx)
  off = (idim - 1) * leading
  buf(idx + off) = src(old_idx + off)
end subroutine sort_gather_part_real_col

attributes(global) subroutine sort_scatter_part_real_col(dst, buf, &
     head_idx, num_parts, leading, idim)
  integer(kind=4), intent(in), value :: leading
  integer(kind=4), intent(in), value :: idim
  real(kind=dp), device :: dst(*)
  real(kind=dp), device :: buf(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, off
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  off = (idim - 1) * leading
  dst(idx + off) = buf(idx + off)
end subroutine sort_scatter_part_real_col

!> Gather/scatter rank-1 real(dp).
attributes(global) subroutine sort_gather_part_real_1d(buf, src, swap_global_d, &
     head_idx, num_parts)
  real(kind=dp), device :: buf(*)
  real(kind=dp), device :: src(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, old_idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  old_idx = swap_global_d(idx)
  buf(idx) = src(old_idx)
end subroutine sort_gather_part_real_1d

attributes(global) subroutine sort_scatter_part_real_1d(dst, buf, head_idx, num_parts)
  real(kind=dp), device :: dst(*)
  real(kind=dp), device :: buf(*)
  integer(kind=4), intent(in), value :: head_idx
