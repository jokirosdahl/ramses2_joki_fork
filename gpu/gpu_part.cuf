!##############################################################################
!##############################################################################
!##############################################################################
!##############################################################################
!> Particle GPU kernels and host-callable dispatchers.
!>
!> Phase 1 entry points:
!>   gpu_split_part      (§4.1) — IMPLEMENTED.
!>   gpu_sort_part       (§4.2) — stub.
!>   gpu_cic_part        (§4.3) — stub.
!>   gpu_kick_drift_part (§4.4) — stub.
!>
!> This file is `include`d from `module gpu_runner` (next to gpu_scan.cuf), so
!> all kernels and host helpers below are module procedures of `gpu_runner`
!> with direct visibility of the module-level device particle / scratch /
!> hash / scan-buffer arrays declared in gpu_runner.cuf.
!>
!> 2D real(dp) particle arrays (xp, vp, fp, jp, xp_swap) are laid out
!> (capacity, ndim) on both host and device, matching part_t in
!> pm/pm_commons.f90:18-37. To keep dummy declarations consistent with the
!> existing repo idiom (which uses `(*)` for runtime-bounded extents), the
!> rank-2 gather/scatter kernels declare the dummy as 1D `(*)` and compute the
!> column-major flat offset `idx + (idim-1)*leading` where `leading` is the
!> device array's allocated leading dimension (= size(host xp, 1) =
!> r%npartmax for DM, set in r_set_grid_device — pm/init_part.f90:62) and is
!> passed by value. NB: `pst%s%p%npart_max` is NOT a safe leading value:
!> r_npart_max (pm/input_part.f90:43) overwrites it to the actual particle
!> count, not the host array capacity.

! ============================================================================
! §4.1 — Bucket classification kernels
! ============================================================================

!> Classify particles in [head_idx : head_idx+num_parts-1] into bucket 0
!> (coarse: stays at level <= ilevel) or bucket 1 (fine: belongs at level
!> >= ilevel+1). This is the boundary special case used when
!> ilevel == levelmin-1 in the host pipeline (pm/rho_fine.f90:97-101).
!> Coarse iff any non-periodic dim places the particle outside [0, box_size).
!> Mirrors host split_part lines 1305-1325.
attributes(global) subroutine bucket_part_boundary(xp, bucket_part, &
     box_size_d, periodic_d, head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp), device :: xp(*)
  integer(kind=4), device :: bucket_part(*)
  real(kind=8), device :: box_size_d(1:3)
  logical, device :: periodic_d(1:3)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart, idim
  logical :: in_domain
  real(kind=8) :: x_idim

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  in_domain = .true.
  do idim = 1, ndim
     if (.not. periodic_d(idim)) then
        x_idim = xp(ipart + (idim-1)*leading)
        if (x_idim < 0d0 .or. x_idim >= box_size_d(idim)) in_domain = .false.
     endif
  end do

  if (in_domain) then
     bucket_part(ipart) = 1   ! fine: stays at finer level
  else
     bucket_part(ipart) = 0   ! coarse: out-of-box, demoted
  endif
end subroutine bucket_part_boundary

!> General case: ilevel >= levelmin. For each particle, compute the parent
!> grid Cartesian key at level `ilevel`, look it up in the device hash table,
!> and classify as coarse iff (igrid == 0) OR (parent cell is a leaf, i.e.
!> not refined). Mirrors host split_part lines 1340-1390 and the host
!> get_grid call with flush_cache=.false./fetch_cache=.true. — in single-rank
!> mode a hash miss is the same as "particle is in a leaf or out of domain".
!> Cartesian-key encoding identical to insert_hash_kernel
!> (gpu/gpu_refine.cuf:225-232).
attributes(global) subroutine bucket_part_general(xp, bucket_part, &
     grid, hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, leading)
  ! hash_get is a module procedure of gpu_runner (gpu_hash.cuf is
  ! `include`d at the top of gpu_runner.cuf alongside gpu_scan.cuf /
  ! gpu_part.cuf), so it is visible here without an explicit `use`.
  ! That makes the device call intra-compilation-unit, satisfying the
  ! build's `-gpu=...,nordc` constraint (no relocatable device code).
  integer(kind=4), intent(in), value :: leading
  real(kind=dp), device :: xp(*)
  integer(kind=4), device :: bucket_part(*)
  type(oct), device :: grid(*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3
  real(kind=8), intent(in), value :: dx_loc
  integer(kind=4), intent(in), value :: ilevel
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart, idim, igrid, icell
  integer(kind=4) :: ix(1:3), ii(1:3)
  integer(kind=8) :: ix8, iy8, iz8, nx, offset, key
  real(kind=8) :: skip(1:3), x(1:3), xs, inv_dx_loc, inv_2dx_loc

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3
  inv_dx_loc  = 1d0 / dx_loc
  inv_2dx_loc = 0.5d0 * inv_dx_loc

  ix = 0
  do idim = 1, ndim
     xs = xp(ipart + (idim-1)*leading) + skip(idim)
     ix(idim) = floor(xs * inv_2dx_loc)
  end do

  ! Build Cartesian-key encoding identical to insert_hash_kernel.
  ix8 = int(ix(1), kind=8)
  iy8 = int(ix(2), kind=8)
  iz8 = int(ix(3), kind=8)
  nx  = int(ckey_max_d(ilevel), kind=8)
  offset = key_off_d(ilevel)
  key = offset + ix8 + iy8*nx + iz8*nx*nx

  igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

  if (igrid == 0) then
     bucket_part(ipart) = 0    ! coarse: hash miss
     return
  endif

  ! Compute in-cell index inside the parent (igrid) oct.
  ! NB: cannot use `#if NDIM==N` here — gpu_part.cuf is `include`d into
  ! gpu_runner.cuf via the Fortran `include` statement, which happens AFTER
  ! the CPP pass has finished on gpu_runner.cuf, so any CPP directives in
  ! this file would be passed through to nvfortran as raw text. Use a
  ! runtime expression keyed on the `ndim` parameter constant — the dead
  ! arms are eliminated at compile time. icell = 1 + sum(ii(idim) * 2^(idim-1)).
  do idim = 1, ndim
     x(idim) = (xp(ipart + (idim-1)*leading) + skip(idim)) * inv_dx_loc
     ii(idim) = int(x(idim) - 2*ix(idim))
  end do
  icell = 1
  do idim = 1, ndim
     icell = icell + ii(idim) * (2**(idim-1))
  end do

  if (.not. grid(igrid)%refined(icell)) then
     bucket_part(ipart) = 0    ! coarse: leaf cell
  else
     bucket_part(ipart) = 1    ! fine: refined cell
  endif
end subroutine bucket_part_general

! ============================================================================
! §4.1 — Prefix-sum init from bucket_part
! ============================================================================

!> Write prefix_sum(idx) := bucket_part(idx) over the slice. Convention
!> matches existing init_prefix_sum_level / init_prefix_sum_bit
!> (gpu/gpu_refine.cuf:355-421): 0 stays in the LEFT bucket, 1 goes to the
!> RIGHT bucket. compute_local_swap_table then places coarse (0) at
!> [head, head+n_coarse-1] and fine (1) at [head+n_coarse, head+num-1],
!> stably preserving relative order within each bucket.
attributes(global) subroutine init_prefix_sum_part(bucket_part, prefix_sum_d, &
     head_idx, num_parts)
  integer(kind=4), device :: bucket_part(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  prefix_sum_d(idx) = bucket_part(idx)
end subroutine init_prefix_sum_part

! ============================================================================
! §4.1 — Typed gather/scatter kernels
!   Convention (matches gpu_refine.cuf:503-784): gather reads
!   src(swap_global(new_idx)) into buf(new_idx); scatter copies buf(new_idx)
!   into dst(new_idx).
! ============================================================================

!> Rank-2 real(dp) gather (xp/vp/fp/jp). The dummy is declared as 1D `(*)`
!> and the kernel computes the column-major flat offset using `leading`,
!> the device array's allocated leading dim (== size(host xp, 1) ==
!> r%npartmax for DM, set in r_set_grid_device). NOT pst%s%p%npart_max,
!> which is the dynamic actual-particle-count post-r_npart_max.
attributes(global) subroutine sort_gather_part_real_2d(buf, src, swap_global_d, &
     head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp), device :: buf(*)
  real(kind=dp), device :: src(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, old_idx, idim
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  old_idx = swap_global_d(idx)
  do idim = 1, ndim
     buf(idx + (idim-1)*leading) = src(old_idx + (idim-1)*leading)
  end do
end subroutine sort_gather_part_real_2d

attributes(global) subroutine sort_scatter_part_real_2d(dst, buf, &
     head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp), device :: dst(*)
  real(kind=dp), device :: buf(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, idim
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  do idim = 1, ndim
     dst(idx + (idim-1)*leading) = buf(idx + (idim-1)*leading)
  end do
end subroutine sort_scatter_part_real_2d

!> Rank-1 real(dp) gather/scatter (mp/zp/tp/tm/size_p/charge).
attributes(global) subroutine sort_gather_part_real_1d(buf, src, swap_global_d, &
     head_idx, num_parts)
  real(kind=dp), device :: buf(*)
  real(kind=dp), device :: src(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, old_idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  old_idx = swap_global_d(idx)
  buf(idx) = src(old_idx)
end subroutine sort_gather_part_real_1d

attributes(global) subroutine sort_scatter_part_real_1d(dst, buf, head_idx, num_parts)
  real(kind=dp), device :: dst(*)
  real(kind=dp), device :: buf(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  dst(idx) = buf(idx)
end subroutine sort_scatter_part_real_1d

!> Rank-1 particle-id gather/scatter (idp/idm).
!> Kind = `i8b` (parameter from amr_parameters: 4 by default, 8 with -DLONGINT)
!> — must match the module-level allocations of idp/idm/idp_swap, NOT the
!> literal `kind=8` (which fails when LONGINT is undefined).
attributes(global) subroutine sort_gather_part_i8_1d(buf, src, swap_global_d, &
     head_idx, num_parts)
  integer(i8b),    device :: buf(*)
  integer(i8b),    device :: src(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, old_idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  old_idx = swap_global_d(idx)
  buf(idx) = src(old_idx)
end subroutine sort_gather_part_i8_1d

attributes(global) subroutine sort_scatter_part_i8_1d(dst, buf, head_idx, num_parts)
  integer(i8b),    device :: dst(*)
  integer(i8b),    device :: buf(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  dst(idx) = buf(idx)
end subroutine sort_scatter_part_i8_1d

!> Rank-1 integer(kind=4) gather/scatter (levelp/idt). Reuses module-level
!> `workp` as scratch (host split_part uses workp as in-place cyclic-swap
!> scratch — its post-call contents are not read by any caller, so on device
!> we may freely repurpose it as gather/scatter scratch; see §13).
attributes(global) subroutine sort_gather_part_i4_1d(buf, src, swap_global_d, &
     head_idx, num_parts)
  integer(kind=4), device :: buf(*)
  integer(kind=4), device :: src(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, old_idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  old_idx = swap_global_d(idx)
  buf(idx) = src(old_idx)
end subroutine sort_gather_part_i4_1d

attributes(global) subroutine sort_scatter_part_i4_1d(dst, buf, head_idx, num_parts)
  integer(kind=4), device :: dst(*)
  integer(kind=4), device :: buf(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  dst(idx) = buf(idx)
end subroutine sort_scatter_part_i4_1d

! ============================================================================
! §4.1 — Host helper: lazily grow scan work arrays for particle slices
! ============================================================================

!> Init_amr.f90:144-149 sizes swap_local/swap_global/prefix_sum and the three
!> partial_sums_* to (ngridmax+ncachemax). For particle scans we may need up
!> to size(host_xp, 1) elements (the host particle array capacity, =
!> r%npartmax for DM). Grow lazily inside gpu_split_part / gpu_sort_part.
!> All these buffers are overwritten before each use
!> (init_global_swap_table_kernel, init_prefix_sum_*), so deallocate /
!> reallocate is safe.
subroutine ensure_scan_capacity_part(min_capacity)
  integer(kind=4), intent(in) :: min_capacity
  integer(kind=4), parameter :: block_size = 256
  integer(kind=4) :: gs0, gs1, gs2

  if (min_capacity <= 0) return

  if (allocated(swap_local)) then
     if (size(swap_local) < min_capacity) then
        deallocate(swap_local)
        allocate(swap_local(1:min_capacity))
     endif
  else
     allocate(swap_local(1:min_capacity))
  endif

  if (allocated(swap_global)) then
     if (size(swap_global) < min_capacity) then
        deallocate(swap_global)
        allocate(swap_global(1:min_capacity))
     endif
  else
     allocate(swap_global(1:min_capacity))
  endif

  if (allocated(prefix_sum)) then
     if (size(prefix_sum) < min_capacity) then
        deallocate(prefix_sum)
        allocate(prefix_sum(1:min_capacity))
     endif
  else
     allocate(prefix_sum(1:min_capacity))
  endif

  gs0 = max(1, (min_capacity + block_size - 1) / block_size)
  gs1 = max(1, (gs0 + block_size - 1) / block_size)
  gs2 = max(1, (gs1 + block_size - 1) / block_size)

  if (allocated(partial_sums_0)) then
     if (size(partial_sums_0) < gs0) then
        deallocate(partial_sums_0)
        allocate(partial_sums_0(1:gs0))
     endif
  else
     allocate(partial_sums_0(1:gs0))
  endif
  if (allocated(partial_sums_1)) then
     if (size(partial_sums_1) < gs1) then
        deallocate(partial_sums_1)
        allocate(partial_sums_1(1:gs1))
     endif
  else
     allocate(partial_sums_1(1:gs1))
  endif
  if (allocated(partial_sums_2)) then
     if (size(partial_sums_2) < gs2) then
        deallocate(partial_sums_2)
        allocate(partial_sums_2(1:gs2))
     endif
  else
     allocate(partial_sums_2(1:gs2))
  endif
end subroutine ensure_scan_capacity_part

!##############################################################################
!##############################################################################
!##############################################################################
!##############################################################################
!> §4.1 host dispatcher — bucket-sort DM particles into coarse / fine groups
!> at level `ilevel`, mirroring host split_part (pm/rho_fine.f90:1278-1505).
!> Operates on the slice [headp(ilevel) : tailp(nlevelmax)]. After this
!> routine returns:
!>   - particles classified coarse occupy [headp(ilevel) : tailp(ilevel)],
!>   - particles classified fine   occupy [headp(ilevel)+n_coarse : tailp(nlevelmax)],
!>   - within each bucket relative order is preserved (stable, matches the
!>     host's "Hilbert ordering after partitioning" guarantee),
!>   - headp(ilev) / tailp(ilev) for ilev > ilevel are updated as in the
!>     host (lines 1396-1400),
!>   - levelp signs are unchanged (host net-toggles them and flips back —
!>     see lines 1305-1422 — so the GPU port simply leaves them alone).
subroutine gpu_split_part(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       compute_local_swap_table, update_global_swap_table
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, num_parts, n_fine, n_coarse, ilev, leading
  integer :: num_threads, num_blocks
  real(kind=8) :: dx_loc, skip1, skip2, skip3

  call nvtxStartRange("gpu_split_part", color=4) ! purple

  ! Slice [headp(ilevel) : tailp(nlevelmax)] — same as host loop bounds.
  head_idx = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(sim%r%nlevelmax) - head_idx + 1

  if (num_parts <= 0) then
     ! Empty slice: still must mirror host metadata.
     sim%p%tailp(ilevel) = sim%p%headp(ilevel) - 1
     do ilev = ilevel + 1, sim%r%nlevelmax
        sim%p%headp(ilev) = sim%p%tailp(ilevel) + 1
        sim%p%tailp(ilev) = sim%p%npart
     end do
     call nvtxEndRange()
     return
  endif

  if (.not. allocated(xp)) then
     ! Defensive: device particle arrays were never set up
     ! (e.g. r%part==.false. or host xp not allocated; r_set_grid_device
     ! skips the H->D block).
     call nvtxEndRange()
     return
  endif

  ! Leading dim of every rank-2 device particle array (xp/vp/fp/jp/xp_swap)
  ! and the natural upper bound for the per-particle scratch arrays. Equals
  ! the host array capacity (r%npartmax for DM), set in r_set_grid_device.
  ! See file-header comment for why pst%s%p%npart_max is NOT a safe value.
  leading = size(xp, 1)

  ! 1. Grow scan work arrays if the particle slice can exceed their current
  !    capacity (init_amr sizes them to ngridmax+ncachemax, which may be
  !    smaller than the host particle capacity).
  call ensure_scan_capacity_part(leading)

  ! 2. Per-particle bucket classification.
  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  if (ilevel == sim%r%levelmin - 1) then
     call bucket_part_boundary<<<num_blocks, num_threads>>>(xp, bucket_part, &
          box_size, periodic, head_idx, num_parts, leading)
  else
     dx_loc = sim%r%boxlen / 2d0**ilevel
     ! Use parameter-keyed runtime ifs (not #if NDIM>=N) — see note inside
     ! bucket_part_general for why CPP cannot run on this file's body.
     skip1 = 0d0
     skip2 = 0d0
     skip3 = 0d0
     if (ndim >= 1) skip1 = sim%m%skip(1)
     if (ndim >= 2) skip2 = sim%m%skip(2)
     if (ndim >= 3) skip3 = sim%m%skip(3)
     call bucket_part_general<<<num_blocks, num_threads>>>(xp, bucket_part, &
          grid, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, &
          leading)
  endif
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  ! 3. Stable bucket sort using the existing scan + swap pipeline.
  ! 3a. swap_global := identity over the slice.
  call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(swap_global, &
       head_idx, num_parts)

  ! 3b. prefix_sum(idx) := bucket_part(idx) over the slice
  !     (0 = stays left = coarse, 1 = goes right = fine).
  call init_prefix_sum_part<<<num_blocks, num_threads>>>(bucket_part, prefix_sum, &
       head_idx, num_parts)

  ! 3c. Inclusive prefix sum -> n_fine = total number of fine particles.
  call gpu_scan(head_idx, num_parts, n_fine)
  n_coarse = num_parts - n_fine

  ! 3d. Local swap table: coarse -> [head, head+n_coarse-1],
  !                       fine   -> [head+n_coarse, head+num-1].
  call compute_local_swap_table<<<num_blocks, num_threads>>>(swap_local, &
       swap_global, prefix_sum, head_idx, num_parts)

  ! 3e. swap_global := swap_local (final permutation).
  call update_global_swap_table<<<num_blocks, num_threads>>>(swap_global, &
       swap_local, head_idx, num_parts)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  ! 4. Out-of-place gather/scatter for every host-physically-swapped field.
  !    Mandatory: xp, vp, mp, levelp, idp.
  call sort_gather_part_real_2d<<<num_blocks, num_threads>>>(xp_swap, xp, &
       swap_global, head_idx, num_parts, leading)
  call sort_scatter_part_real_2d<<<num_blocks, num_threads>>>(xp, xp_swap, &
       head_idx, num_parts, leading)

  call sort_gather_part_real_2d<<<num_blocks, num_threads>>>(xp_swap, vp, &
       swap_global, head_idx, num_parts, leading)
  call sort_scatter_part_real_2d<<<num_blocks, num_threads>>>(vp, xp_swap, &
       head_idx, num_parts, leading)

  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, mp, &
       swap_global, head_idx, num_parts)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(mp, mp_swap, &
       head_idx, num_parts)

  call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(workp, levelp, &
       swap_global, head_idx, num_parts)
  call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(levelp, workp, &
       head_idx, num_parts)

  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, idp, &
       swap_global, head_idx, num_parts)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(idp, idp_swap, &
       head_idx, num_parts)

  ! Optional: only if device counterpart is allocated (r_set_grid_device
  ! mirrors host `allocated(p%X)` predicate, see gpu_manager.f90 §9 follow-up).
  if (allocated(fp)) then
     call sort_gather_part_real_2d<<<num_blocks, num_threads>>>(xp_swap, fp, &
          swap_global, head_idx, num_parts, leading)
     call sort_scatter_part_real_2d<<<num_blocks, num_threads>>>(fp, xp_swap, &
          head_idx, num_parts, leading)
  endif
  if (allocated(jp)) then
     call sort_gather_part_real_2d<<<num_blocks, num_threads>>>(xp_swap, jp, &
          swap_global, head_idx, num_parts, leading)
     call sort_scatter_part_real_2d<<<num_blocks, num_threads>>>(jp, xp_swap, &
          head_idx, num_parts, leading)
  endif
  if (allocated(zp)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, zp, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(zp, mp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(tp)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, tp, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(tp, mp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(tm)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, tm, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(tm, mp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(size_p)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, size_p, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(size_p, mp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(charge)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(mp_swap, charge, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(charge, mp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(idm)) then
     call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, idm, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(idm, idp_swap, &
          head_idx, num_parts)
  endif
  if (allocated(idt)) then
     call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(workp, idt, &
          swap_global, head_idx, num_parts)
     call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(idt, workp, &
          head_idx, num_parts)
  endif
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  ! 5. Update host metadata (matches host split_part lines 1396-1400).
  sim%p%tailp(ilevel) = sim%p%headp(ilevel) + n_coarse - 1
  do ilev = ilevel + 1, sim%r%nlevelmax
     sim%p%headp(ilev) = sim%p%tailp(ilevel) + 1
     sim%p%tailp(ilev) = sim%p%npart
  end do

  call nvtxEndRange()
end subroutine gpu_split_part

! ============================================================================
! §4.2 — Hilbert-key compute kernel + bit-radix init + sortp writeback
! ============================================================================

!> Per-particle Hilbert key for sort_part. For each particle in
!> [head_idx : head_idx+num_parts-1], compute the parent-oct Cartesian key
!> at AMR level `ilevel` (resolution 2**(ilevel-1) per axis, range
!> [0, ckey_max(ilevel))) and convert to a Hilbert key.
!>
!> The host's sort_hilbert (pm/rho_fine.f90:2031-2061) sorts particles at the
!> OCT level (final_level = AMR_ilevel - 1, ckey_factor = 2**(ilevel-1)/boxlen
!> at the deepest recursion), so the GPU port matches by passing
!> `level = ilevel - 1` and `dx_inv = 2**(ilevel-1) / boxlen`.
!>
!> Note: the prompt §4.2 step 1 wording (`2**ilevel/boxlen`) is one bit
!> finer than host; sortp divergence is downgraded to a warning by §10
!> ("permutation valid"), so either choice is harness-accepted, but matching
!> host minimizes diff noise. See modelA.md.
attributes(global) subroutine compute_hkey_part_kernel(xp, hkey_part_d, &
     skip1, skip2, skip3, dx_inv, head_idx, num_parts, leading, level)
  ! hilbert_key is a module procedure of gpu_runner (gpu_hilbert.cuf is
  ! `include`d at the top of gpu_runner.cuf). Same nordc-friendly
  ! include-into-caller pattern as the bucket kernel's hash_get usage.
  integer(kind=4), intent(in), value :: leading
  real(kind=dp),   device :: xp(*)
  integer(kind=8), device :: hkey_part_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3
  real(kind=8), intent(in), value :: dx_inv
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: level

  integer :: thread_idx, block_idx, idx, ipart, idim
  integer(kind=4) :: ix(1:ndim)
  real(kind=8) :: skip(1:3), xs

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  do idim = 1, ndim
     xs = xp(ipart + (idim-1)*leading) + skip(idim)
     ix(idim) = floor(xs * dx_inv)
  end do

  hkey_part_d(ipart) = hilbert_key(ix, level)
end subroutine compute_hkey_part_kernel

!> Init prefix_sum from a single-digit bucket of hkey_part. Mirrors
!> init_prefix_sum_bit (gpu/gpu_refine.cuf:388-421) but reads the bucket
!> from hkey_part(old_idx) instead of grid(old_idx)%hkey(1). Convention is
!> identical: prefix_sum=0 for matching bucket (lands LEFT after the stable
!> compute_local_swap_table); prefix_sum=1 otherwise (lands RIGHT).
attributes(global) subroutine init_prefix_sum_part_bit(hkey_part_d, swap_global_d, &
     prefix_sum_d, head_idx, num_parts, skip_bit, bucket)
  integer(kind=8), device :: hkey_part_d(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: skip_bit
  integer(kind=4), intent(in), value :: bucket

  integer :: thread_idx, block_idx, idx, old_idx, ibucket
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx

  old_idx = swap_global_d(idx)
  ibucket = int(ibits(hkey_part_d(old_idx), skip_bit, ndim), kind=4)

  if (ibucket == bucket) then
     prefix_sum_d(idx) = 0
  else
     prefix_sum_d(idx) = 1
  endif
end subroutine init_prefix_sum_part_bit

!> Final pass of gpu_sort_part: write swap_global into the device sortp array
!> over the active slice. Host sort_part returns sortp(i) = original index of
!> the particle now in position i, which is exactly what swap_global encodes
!> after the LSD radix loop.
attributes(global) subroutine write_sortp_part(sortp_d, swap_global_d, &
     head_idx, num_parts)
  integer(kind=4), device :: sortp_d(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  sortp_d(idx) = swap_global_d(idx)
end subroutine write_sortp_part

!##############################################################################
!##############################################################################
!##############################################################################
!##############################################################################
!> §4.2 host dispatcher — Hilbert-sort DM particles in the slice
!> [headp(ilevel) : tailp(nlevelmax)] and write the resulting permutation
!> into device `sortp`. Mirrors host sort_part (pm/rho_fine.f90:2031-2061),
!> which calls sort_hilbert with final_level = ilevel-1 (oct-level
!> resolution). On output, walking sortp from head_idx upward yields
!> particles in Hilbert order at the OCT level for AMR level `ilevel`.
!>
!> Algorithm: LSD radix sort with `ndim`-bit digits over `hilbert_key(ix,
!> ilevel-1)` (level-1 digits = ndim*(ilevel-1) bits total). For each digit
!> from LSB upward, run twotondim-1 stable 0/1 splits to place buckets 0..6
!> in order; bucket 7 falls into place at the right. Reuses the same scan
!> primitives as gpu_split_part (init_prefix_sum_part_bit, gpu_scan,
!> compute_local_swap_table, update_global_swap_table — same pattern as
!> gpu_refine's grid sort, gpu/gpu_runner.cuf:574-623).
!>
!> Particle arrays xp/vp/mp/... are NOT physically permuted — sort_part
!> only writes sortp.
subroutine gpu_sort_part(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       compute_local_swap_table, update_global_swap_table
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, num_parts, sub_head, sub_num, n_right, n_match
  integer(kind=4) :: num_blocks_sub, leading
  integer :: num_threads, num_blocks
  integer :: ibit, ibucket, skip_bit, level
  real(kind=8) :: dx_inv, skip1, skip2, skip3

  call nvtxStartRange("gpu_sort_part", color=4) ! purple

  ! Slice [headp(ilevel) : tailp(nlevelmax)] — same as host sort_part bounds.
  head_idx  = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(sim%r%nlevelmax) - head_idx + 1

  if (num_parts <= 0) then
     call nvtxEndRange()
     return
  endif

  if (.not. allocated(xp)) then
     ! Defensive: device particle arrays were never set up
     ! (r%part==.false. or r_set_grid_device skipped its host xp gate).
     call nvtxEndRange()
     return
  endif

  ! Leading dim of every rank-2 device particle array; also the natural
  ! upper bound for scan/scratch sizing. Equals size(host xp, 1) =
  ! r%npartmax for DM, set in r_set_grid_device. See file-header comment
  ! for why pst%s%p%npart_max is NOT a safe value here.
  leading = size(xp, 1)

  ! Grow scan work arrays if necessary. init_amr sizes them to
  ! ngridmax+ncachemax which may be smaller than the host particle
  ! capacity. Idempotent — first call grows, subsequent calls are no-ops.
  ! Same helper as §4.1.
  call ensure_scan_capacity_part(leading)

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  ! Trivial case: ilevel == 1 -> level == 0 -> 0 bits to radix-sort.
  ! sortp degenerates to identity over the slice.
  level = ilevel - 1
  if (level <= 0) then
     call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(swap_global, &
          head_idx, num_parts)
     call write_sortp_part<<<num_blocks, num_threads>>>(sortp, swap_global, &
          head_idx, num_parts)
     call GPU_Error_Check("gpu/gpu_part.cuf", 0)
     call nvtxEndRange()
     return
  endif

  ! 1. Compute Hilbert keys at oct-level resolution for AMR level `ilevel`
  !    (level = ilevel-1 -> ndim*(ilevel-1) bits per key, in the LSBs).
  dx_inv = 2.0d0**(ilevel-1) / sim%r%boxlen
  skip1 = 0d0
  skip2 = 0d0
  skip3 = 0d0
  if (ndim >= 1) skip1 = sim%m%skip(1)
  if (ndim >= 2) skip2 = sim%m%skip(2)
  if (ndim >= 3) skip3 = sim%m%skip(3)
  call compute_hkey_part_kernel<<<num_blocks, num_threads>>>(xp, hkey_part, &
       skip1, skip2, skip3, dx_inv, head_idx, num_parts, leading, level)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  ! 2. Initialize swap_global := identity over the slice. Each digit pass
  !    advances the partition by partitioning swap_global in place (the
  !    permutation accumulates across passes — standard LSD radix).
  call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(swap_global, &
       head_idx, num_parts)

  ! 3. LSD radix loop. ibit indexes the digit position from LSB (level digits
  !    -> skip_bit=0, bits 0..ndim-1) up to MSB (1 digit -> skip_bit=ndim*(level-1),
  !    bits ndim*(level-1)..ndim*level-1). Within each digit, run twotondim-1
  !    stable 0/1 splits, pulling buckets 0..twotondim-2 to the left in order;
  !    bucket twotondim-1 falls into place at the right of the residual slice.
  !    Same nested-loop structure as the grid Hilbert sort in gpu_runner.cuf:574-623.
  do ibit = level, 1, -1
     skip_bit = ndim * (level - ibit)
     sub_head = head_idx
     sub_num  = num_parts
     do ibucket = 1, twotondim - 1
        if (sub_num <= 0) exit
        num_blocks_sub = (sub_num + num_threads - 1) / num_threads
        call init_prefix_sum_part_bit<<<num_blocks_sub, num_threads>>>(hkey_part, &
             swap_global, prefix_sum, sub_head, sub_num, skip_bit, ibucket - 1)
        ! gpu_scan returns total inclusive sum = number of "1"s = number of
        ! particles in the residual non-target buckets (going right).
        call gpu_scan(sub_head, sub_num, n_right)
        call compute_local_swap_table<<<num_blocks_sub, num_threads>>>(swap_local, &
             swap_global, prefix_sum, sub_head, sub_num)
        call update_global_swap_table<<<num_blocks_sub, num_threads>>>(swap_global, &
             swap_local, sub_head, sub_num)
        ! Advance sub_slice past the just-placed target bucket.
        n_match = sub_num - n_right
        sub_head = sub_head + n_match
        sub_num  = sub_num  - n_match
     end do
  end do
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  ! 4. Materialize the permutation into device sortp.
  call write_sortp_part<<<num_blocks, num_threads>>>(sortp, swap_global, &
       head_idx, num_parts)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)

  call nvtxEndRange()
end subroutine gpu_sort_part
!##############################################################################
!##############################################################################
!##############################################################################
!##############################################################################
! ============================================================================
! §4.3 — CIC mass deposition: per-particle scatter with global atomicadd
! ============================================================================
!
! Design (locked with Eric 2026-05-06):
!   * Per-particle parallelization: one CUDA thread per particle in the slice
!     [headp(ilevel) : tailp(nlevelmax)]. Differs from `multipole_cic`
!     (gpu/gpu_rho.cuf:241) which is a per-cell-block GATHER with a 6^3
!     shared-mem tile.
!   * 27-cell uniform evaluation (gpu_part_prompt.md §15.2): each thread loops
!     over the full 3x3x3 = 27 neighbor cells of its host cell at level
!     (ilevel+1) with weights summing to 1. For CIC, 19 of the 27 weights are
!     guaranteed zero (CIC range is a 2x2x2 sub-box); we still atomic-add the
!     zero deposits to keep control flow uniform across the warp.
!   * Deposit is `atomicadd(real(dp))` directly on global `rho` and `nref`.
!     No intermediate "virtual particle" buffer (option B from the design
!     discussion); H100 hardware atomics on dp global make option A (this) the
!     simplest correct baseline. If profiling shows rho atomic contention
!     dominates, switch to a sort+segmented-reduce pipeline behind this same
!     dispatcher signature without touching r_cic_part.
!   * Per-axis CIC weights for offset (-1, 0, +1) within the host cell, given
!     fractional position f = x - floor(x) in [0, 1):
!         w(-1) = max(0, 0.5 - f)
!         w(0)  = 1 - |f - 0.5|
!         w(+1) = max(0, f - 0.5)
!     3D weight is the tensor product. Sums to 1 by construction.
!
! Mesh sync: rho/nref are NOT copied back to host inside this kernel.
! `r_cic_part` (`pm/rho_fine.f90`) calls `gpu_to_host_mesh(pst)` only under
! `#ifdef PART_DUMP` so the harness's `dump_mesh_state` sees post-deposit
! values. Production runs keep rho/nref device-only forever (consumed by the
! GPU multigrid solver and gpu_kick_drift_part).

!> Per-particle CIC mass deposit kernel. Each thread handles one particle in
!> the slice [head_idx, head_idx+num_parts-1], loops over its 27 neighbor
!> cells at level (ilevel+1), and atomicadd's into global rho (and nref when
!> r%m_refine(ilevel) >= 0).
attributes(global) subroutine cic_part_kernel(xp, mp, rho_d, nref_d, &
     hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     box_ckey_min_d, box_ckey_max_d, periodic_d, &
     skip1, skip2, skip3, dx_loc, vol_loc, &
     m_refine_at_level, mass_cut_refine, &
     ilevel, head_idx, num_parts, leading)
  ! hash_get is a module procedure of gpu_runner (gpu_hash.cuf is `include`d
  ! into gpu_runner.cuf), so the device call is intra-compilation-unit and
  ! satisfies the build's -gpu=...,nordc constraint. Same pattern as the §4.1
  ! bucket kernel and §4.2 hkey kernel.
  integer(kind=4), intent(in), value :: leading
  real(kind=dp),   device :: xp(*)
  real(kind=dp),   device :: mp(*)
  real(kind=dp),   device :: rho_d (1:twotondim, *)
  real(kind=dp),   device :: nref_d(1:twotondim, *)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3, *)
  integer(kind=4), device :: box_ckey_max_d(1:3, *)
  logical,         device :: periodic_d(1:3)
  real(kind=8), intent(in), value :: skip1, skip2, skip3
  real(kind=8), intent(in), value :: dx_loc, vol_loc
  real(kind=8), intent(in), value :: m_refine_at_level
  real(kind=8), intent(in), value :: mass_cut_refine
  integer(kind=4), intent(in), value :: ilevel
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart
  integer :: i, j, k, idim, info, igrid_target, cell_idx_target
  integer(kind=4) :: host_ckey(1:3), target_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=4) :: box_min(1:3), box_max(1:3), box_span
  integer(kind=8) :: nx8, offset8, key
  real(kind=8) :: skip(1:3), x(1:3), f(1:3)
  real(kind=8) :: wx(0:2), wy(0:2), wz(0:2), w
  real(kind=dp) :: deposit, deposit_nref
  real(kind=8) :: mp_local
  logical :: in_domain, update_nref, do_nref_for_this_particle

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  ! Position in level-(ilevel+1) cell coords (= level-(ilevel+1) oct-key
  ! resolution, ckey_max(ilevel+1) = 2**ilevel). dx_loc = boxlen/2**ilevel
  ! is the cell spacing at level ilevel == oct spacing at level (ilevel+1).
  ! Initialize unused dims to zero so the periodic checks below behave for
  ! ndim < 3 builds.
  host_ckey(1:3) = 0
  f(1:3) = 0d0
  do idim = 1, ndim
     x(idim) = (xp(ipart + (idim-1)*leading) + skip(idim)) / dx_loc
     host_ckey(idim) = floor(x(idim))
     f(idim) = x(idim) - host_ckey(idim)
  end do

  ! Per-axis CIC weights for the 3-cell window {-1, 0, +1} (locked §15.2).
  ! For axes with idim > ndim, set w(0) = 1 so the tensor product collapses
  ! to the lower-dim case.
  wx(0) = max(0d0, 0.5d0 - f(1))
  wx(1) = 1d0 - abs(f(1) - 0.5d0)
  wx(2) = max(0d0, f(1) - 0.5d0)
  wy(0) = max(0d0, 0.5d0 - f(2))
  wy(1) = 1d0 - abs(f(2) - 0.5d0)
  wy(2) = max(0d0, f(2) - 0.5d0)
  wz(0) = max(0d0, 0.5d0 - f(3))
  wz(1) = 1d0 - abs(f(3) - 0.5d0)
  wz(2) = max(0d0, f(3) - 0.5d0)
  ! Collapse unused dims (NB: ndim is a parameter, dead arms eliminated).
  if (ndim < 3) then
     wz(0) = 0d0; wz(1) = 1d0; wz(2) = 0d0
  endif
  if (ndim < 2) then
     wy(0) = 0d0; wy(1) = 1d0; wy(2) = 0d0
  endif

  ! Box bounds at level (ilevel+1) for periodic wrap. Reads once per particle.
  box_min(1:3) = 0
  box_max(1:3) = 1
  do idim = 1, ndim
     box_min(idim) = box_ckey_min_d(idim, ilevel+1)
     box_max(idim) = box_ckey_max_d(idim, ilevel+1)
  end do

  mp_local = mp(ipart)

  ! Per-particle nref-deposit decision (host pm/rho_fine.f90:859-872, DM branch).
  update_nref = (m_refine_at_level >= 0d0)
  do_nref_for_this_particle = .false.
  if (update_nref) then
     if (mass_cut_refine > 0d0) then
        do_nref_for_this_particle = (mp_local < mass_cut_refine)
     else
        do_nref_for_this_particle = .true.
     endif
  endif

  ! Loop over the 27 cells in the 3x3x3 neighborhood of host_ckey (uniform
  ! per locked decision §15.2; 19 of 27 weights are 0 for CIC and the
  ! corresponding atomic-adds are no-ops by value).
  do k = 0, 2
     do j = 0, 2
        do i = 0, 2
           w = wx(i) * wy(j) * wz(k)

           ! Target cell ckey at level (ilevel+1).
           target_ckey(1) = host_ckey(1) + (i - 1)
           target_ckey(2) = host_ckey(2) + (j - 1)
           target_ckey(3) = host_ckey(3) + (k - 1)

           ! Periodic wrap; non-periodic out-of-domain → skip.
           in_domain = .true.
           do idim = 1, ndim
              if (periodic_d(idim)) then
                 box_span = box_max(idim) - box_min(idim)
                 if (target_ckey(idim) <  box_min(idim)) target_ckey(idim) = target_ckey(idim) + box_span
                 if (target_ckey(idim) >= box_max(idim)) target_ckey(idim) = target_ckey(idim) - box_span
              else
                 if (target_ckey(idim) <  box_min(idim)) in_domain = .false.
                 if (target_ckey(idim) >= box_max(idim)) in_domain = .false.
              endif
           end do
           if (.not. in_domain) cycle

           ! Father oct ckey at level ilevel + cell-within-father. Equivalent
           ! to host get_parent_cell (amr/nbors_utils.f90:222-249).
           father_ckey(1) = target_ckey(1) / 2
           father_ckey(2) = target_ckey(2) / 2
           father_ckey(3) = target_ckey(3) / 2
           ii(1) = target_ckey(1) - 2 * father_ckey(1)
           ii(2) = target_ckey(2) - 2 * father_ckey(2)
           ii(3) = target_ckey(3) - 2 * father_ckey(3)
           cell_idx_target = 1 + ii(1) + 2*ii(2) + 4*ii(3)

           ! Hash-lookup father oct at level ilevel; same encoding as
           ! insert_hash_kernel (gpu/gpu_refine.cuf:225-232) and the §4.1
           ! bucket kernel.
           nx8 = int(ckey_max_d(ilevel), kind=8)
           offset8 = key_off_d(ilevel)
           key = offset8 + int(father_ckey(1), kind=8) &
                        + int(father_ckey(2), kind=8) * nx8 &
                        + int(father_ckey(3), kind=8) * nx8 * nx8
           igrid_target = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
           if (igrid_target == 0) cycle  ! father oct doesn't exist on this rank

           ! Deposit. Real-dp atomicadd is hardware-accelerated on H100 (sm_90).
           deposit = mp_local * w / vol_loc
           info = atomicadd(rho_d(cell_idx_target, igrid_target), deposit)
           if (do_nref_for_this_particle) then
              deposit_nref = w
              info = atomicadd(nref_d(cell_idx_target, igrid_target), deposit_nref)
           endif
        end do
     end do
  end do
end subroutine cic_part_kernel

!> Multipole accumulation kernel — only invoked at ilevel == levelmin.
!> Iterates over ALL particles (1..p%npart, NOT the level slice — matches
!> host pm/rho_fine.f90:803-812). Atomic-adds into a 4-element device vector
!> multipole_d := (sum mp, sum mp*xp(:,1), sum mp*xp(:,2), sum mp*xp(:,3)).
!> Host adds the result into sim%g%multipole%q after copy-back.
attributes(global) subroutine cic_part_multipole_kernel(xp, mp, multipole_d, &
     npart_actual, leading)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp), device :: xp(*)
  real(kind=dp), device :: mp(*)
  real(kind=8),  device :: multipole_d(1:ndim+1)
  integer(kind=4), intent(in), value :: npart_actual

  integer :: thread_idx, block_idx, idx, ipart, idim, info
  real(kind=8) :: mass

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= npart_actual) return
  ipart = idx + 1                ! 1-indexed slot

  mass = mp(ipart)
  info = atomicadd(multipole_d(1), mass)
  do idim = 1, ndim
     info = atomicadd(multipole_d(idim+1), mass * xp(ipart + (idim-1)*leading))
  end do
end subroutine cic_part_multipole_kernel

!##############################################################################
!##############################################################################
!##############################################################################
!##############################################################################
!> §4.3 host dispatcher — CIC mass deposit for DM particles into device rho /
!> nref at level ilevel, plus the multipole accumulation when ilevel ==
!> levelmin. Mirrors host pm/rho_fine.f90:759-884 (subroutine cic_part), with
!> the per-particle 27-cell scatter design described above.
!>
!> Per-call sequence:
!>   1. Early-return on rtype not in {0, 1} (DM-only contract, host line 798).
!>   2. Empty-slice / unallocated-xp guards.
!>   3. cic_part_kernel: atomic deposit into device rho (and nref when
!>      r%m_refine(ilevel) >= 0).
!>   4. (ilevel == levelmin only) cic_part_multipole_kernel + D->H copy of
!>      the 4-element multipole_d into sim%g%multipole%q.
!>
!> rho / nref are NOT copied back to host. r_cic_part wires
!> gpu_to_host_mesh(pst) under #ifdef PART_DUMP for harness validity.
subroutine gpu_cic_part(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, num_parts, leading, npart_total
  integer :: num_threads, num_blocks
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3
  real(kind=8) :: m_refine_at_level, mass_cut_refine
  real(kind=8) :: multipole_h(1:ndim+1)
  real(kind=8), device :: multipole_d(1:ndim+1)

  call nvtxStartRange("gpu_cic_part", color=4) ! purple

  ! DM type-gate (matches host pm/rho_fine.f90:798).
  if (rtype /= 0 .and. rtype /= 1) then
     call nvtxEndRange()
     return
  endif

  if (.not. allocated(xp)) then
     ! Defensive: device particle arrays were never set up.
     call nvtxEndRange()
     return
  endif

  head_idx    = sim%p%headp(ilevel)
  num_parts   = sim%p%tailp(sim%r%nlevelmax) - head_idx + 1
  npart_total = sim%p%npart
  leading     = size(xp, 1)

  num_threads = 128

  dx_loc  = sim%r%boxlen / 2d0**ilevel
  vol_loc = dx_loc**ndim

  skip1 = 0d0
  skip2 = 0d0
  skip3 = 0d0
  if (ndim >= 1) skip1 = sim%m%skip(1)
  if (ndim >= 2) skip2 = sim%m%skip(2)
  if (ndim >= 3) skip3 = sim%m%skip(3)

  m_refine_at_level = sim%r%m_refine(ilevel)
  mass_cut_refine   = sim%r%mass_cut_refine

  ! 1. Per-particle CIC deposit over the level slice.
  if (num_parts > 0) then
     num_blocks = (num_parts + num_threads - 1) / num_threads
     call cic_part_kernel<<<num_blocks, num_threads>>>(xp, mp, rho, nref, &
          hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          box_ckey_min, box_ckey_max, periodic, &
          skip1, skip2, skip3, dx_loc, vol_loc, &
          m_refine_at_level, mass_cut_refine, &
          ilevel, head_idx, num_parts, leading)
     call GPU_Error_Check("gpu/gpu_part.cuf", 0)
  endif

  ! 2. Multipole accumulation at the coarsest PIC level. Iterates over ALL
  !    particles (host loops 1..p%npart, not the level slice — see
  !    pm/rho_fine.f90:803-812).
  if (ilevel == sim%r%levelmin .and. npart_total > 0) then
     multipole_h = 0d0
     multipole_d = multipole_h
     num_blocks = (npart_total + num_threads - 1) / num_threads
     call cic_part_multipole_kernel<<<num_blocks, num_threads>>>(xp, mp, &
          multipole_d, npart_total, leading)
     call GPU_Error_Check("gpu/gpu_part.cuf", 0)
     multipole_h = multipole_d
     ! Match host: this rank's contribution is added into the global accumulator.
     sim%g%multipole%q = sim%g%multipole%q + multipole_h
  endif

  call nvtxEndRange()
end subroutine gpu_cic_part
!##############################################################################
!##############################################################################
!##############################################################################
!##############################################################################
  !> Stub: CIC kick-drift / kick-only on DM particles at level `ilevel`.
  !> See §4.4 for the real algorithm — symmetric counterpart of `gpu_cic_part`,
  !> reads f from device and updates xp/vp/fp.
  subroutine gpu_kick_drift_part(sim, ilevel, action_part)
    use nvtx
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    integer, intent(in) :: ilevel
    integer, intent(in) :: action_part

    call nvtxStartRange("gpu_kick_drift_part (stub)", color=4) ! purple
    ! TODO §4.4: load 6^3 f tile, evaluate CIC weights, write fp/vp/xp,
    !            apply periodic wrap. Both action_kick_only (=1) and
    !            action_kick_drift (=2) must be supported.
    call nvtxEndRange()

  end subroutine gpu_kick_drift_part
