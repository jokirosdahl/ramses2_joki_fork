module gpu_utils
  use amr_parameters, only: dp, twotondim
  use oct_commons, only: oct
  use cudafor
  implicit none

  !> @brief
  !> Contains a 6 by 6 by 6 subgrid of primitive variables. Intended to act as a subgrid
  !> where the inner 2 by 2 by 2 cells are "real" and the outer 2 cells are ghost/halo cells.
  !> Can either be used on it's own or allocated in shared memory. Note that it is zero
  !> indexed to make 1D to 3D indexing easier
  type, public :: subgrid_6x6x6cell_primitive
     real(kind=dp), dimension(0:5, 0:5, 0:5) :: density, velocity_x, velocity_y, velocity_z, pressure
     logical      , dimension(0:5, 0:5, 0:5) :: refined
  end type subgrid_6x6x6cell_primitive

  !> @brief
  !> Contains a 6 by 6 by 6 subgrid of conserved variables. Intended to act as a subgrid
  !> where the inner 2 by 2 by 2 cells are "real" and the outer 2 cells are ghost/halo cells.
  !> Can either but used on it's own or allocated in shared memory. Note that it is zero
  !> indexed to make 1D to 3D indexing easier
  type, public :: subgrid_6x6x6cell_conserved
     real(kind=dp), dimension(0:5, 0:5, 0:5) :: density, momentum_x, momentum_y, momentum_z, energy
  end type subgrid_6x6x6cell_conserved

  !> @brief
  !> Derived type for the hash table on the GPU
  type hash_gpu
     integer(kind=4) :: size, used
     integer(kind=8), allocatable, dimension(:) :: key
     integer(kind=4), allocatable, dimension(:) :: val
  end type hash_gpu

  !> @brief
  !> Derived type for the mesh object on the GPU
  type mesh_gpu

     integer(kind=4) :: ngridmax, ncachemax

     logical, dimension(1:3) :: periodic
     integer(kind=4), allocatable, dimension(:) :: ckey_max
     integer(kind=8), allocatable, dimension(:) :: key_off
     integer(kind=4), allocatable, dimension(:,:) :: box_ckey_min
     integer(kind=4), allocatable, dimension(:,:) :: box_ckey_max
     integer(kind=4), allocatable, dimension(:,:,:) :: bound_ckey_min
     integer(kind=4), allocatable, dimension(:,:,:) :: bound_ckey_max

     integer(kind=4), allocatable, dimension(:) :: head
     integer(kind=4), allocatable, dimension(:) :: tail
     integer(kind=4), allocatable, dimension(:) :: noct
     integer(kind=4) :: ifree

     integer(kind=4), allocatable, dimension(:) :: head_cache
     integer(kind=4), allocatable, dimension(:) :: tail_cache
     integer(kind=4), allocatable, dimension(:) :: noct_cache
     integer(kind=4) :: ifree_cache

     type(oct), allocatable, dimension(:) :: grid

     integer(kind=4), allocatable, dimension(:) :: father
     integer(kind=4), allocatable, dimension(:,:) :: nbor

     integer(kind=4), allocatable, dimension(:,:) :: flag1, flag2
     real(kind=dp), allocatable, dimension(:,:,:) :: uold, unew

     integer(kind=4), allocatable, dimension(:) :: swap_local
     integer(kind=4), allocatable, dimension(:) :: swap_global
     integer(kind=4), allocatable, dimension(:) :: prefix_sum
     integer(kind=4), allocatable, dimension(:) :: partial_sums_0
     integer(kind=4), allocatable, dimension(:) :: partial_sums_1

     type(hash_gpu) :: hash

  end type mesh_gpu

contains
   ! ==========================================================================
   !> @brief
   !> Checks for any CUDA errors. Includes a `cudaDeviceSynchronize` which is
   !> where it gets the error code. This synchronization, and error checking
   !> in its entirety, can be disabled by compiling with the
   !> DISABLE_GPU_ERROR_CHECKING flag.
   !>
   !> @param[in] file_name : The name of the file that the check is in, intended
   !> to be used by simply passing the __FILE__ macro
   !> @param[in] line_number: The line number in the file that the check is at,
   !> intended to be used by simply passing the __LINE__ macro
   subroutine GPU_Error_Check(file_name, line_number)
#ifndef DISABLE_GPU_ERROR_CHECKING
      implicit none
      character(len=*), intent(in) :: file_name
      integer, intent(in) :: line_number
      integer :: code

      ! Sync and get code
      code = cudaDeviceSynchronize()

      ! Check the code
      if (code /= cudaSuccess) then
         print *, "GPU_Error_Check: Failed in File: ", file_name, "At Line:", line_number, "With code: ", cudaGetErrorString(code)
         error stop code
      end if
#endif
   end subroutine GPU_Error_Check
   ! ==========================================================================

   ! ==========================================================================
   !> @brief
   !> Compute the cell index within an oct.
   !>
   !> @param[in] i : The i index of the cell, must be 0 or 1
   !> @param[in] j : The j index of the cell, must be 0 or 1
   !> @param[in] k : The k index of the cell, must be 0 or 1
   !>
   !> @return
   !> The index of the cell within the oct
   attributes(host, device) function oct2cell_idx(i, j, k) result(idx)
      integer, intent(in) :: i, j, k
      integer :: idx
      idx = 1 + i + 2*j + 4*k
   end function oct2cell_idx
   ! ==========================================================================
end module gpu_utils

