&RUN_PARAMS
hydro=.false.
poisson=.true.
pic=.true.
ncontrol=1
nsubcycle=1,1,2,2,2
nremap=2
nrestart=0
nstepmax=10
/

&AMR_PARAMS
levelmin=3
levelmax=6
ngridtot=5000
nparttot=2000
boxlen=60.0
/

&INIT_PARAMS
filetype='ascii'
initfile(1)='halo_ics_small/'
/

&OUTPUT_PARAMS
tend=10.0
/

&BOUNDARY_PARAMS
/

&POISSON_PARAMS
gravity_params=35.,10.,0.04,0.15
gravity_type=0
epsilon=1d-4
/


&REFINE_PARAMS
interpol_var=1
interpol_type=0
m_refine=10*2.
/

