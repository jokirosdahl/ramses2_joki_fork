This is the RAMSES parameter file for the Dai & Woodward (1998) MHD shock tube test.
Compile the code with:
make NDIM=1 HYDRO=1 MHD=1

&RUN_PARAMS
hydro=.true.
nsubcycle=4*1,
/

&AMR_PARAMS 
levelmin=3
levelmax=12
ngridmax=10000
nexpand=1
/

&BOUNDARY_PARAMS
bound_levelmin=3
box_size=1.0
box_xmin=1
box_xmax=-1
nbound=2
periodic=.false.
bound_dir=1,1
bound_type=2,2
bound_shift=1,-1
bound_xmin=0,-1
bound_xmax=1,0
/

&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='square'
x_center=0.25,0.75
length_x=0.5,0.5
d_region=1.08,1.0
u_region=1.20,0.0
v_region=0.01,0.0
w_region=0.50,0.0
p_region=0.95,1.0
A_ave=0.5641895835477563
B_region=1.0155412503859613,1.1283791670955126
C_region=0.5641895835477563,0.5641895835477563
/

&OUTPUT_PARAMS
tout=0.2
/

&HYDRO_PARAMS
gamma=1.66666667
courant_factor=0.8
slope_type=2
riemann='roe'
/

&REFINE_PARAMS 
err_grad_d=0.01
err_grad_u=0.05
err_grad_p=0.05
interpol_var=0
interpol_type=2
/



