This namelist performs a cosmological simulation with dark matter only.
You need a grafic file for the initial conditions. You can download one
easily by executing in the command line the following script:
./utils/script/load_cosmo_ic.sh
To compile the code with MPI, type in the command line:
make NDIM=3 MPI=1 UNITS=cosmo CONDINIT=default GRAV=1 HYDRO=0

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nsubcycle=1,1,2
ncontrol=1
verbose=.false.
clump_finder=.true.
/

&OUTPUT_PARAMS
delta_aout=0.1
aend=1.0
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='ics_ramses'
/

&AMR_PARAMS
levelmin=7
levelmax=15
ngridmax=2000000
npartmax=4000000
nexpand=1,
/

&POISSON_PARAMS
epsilon=1.d-4
/

&REFINE_PARAMS
m_refine=10*8.,
/

&CLUMP_PARAMS
density_threshold=80
relevance_threshold=3
saddle_threshold=200
mass_threshold=10
output_clump=.true.
output_peak=.true.
/

