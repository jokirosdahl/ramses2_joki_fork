This namelist performs a cosmological simulation with dark matter and gas.
Only gas cooling is included here. You need a grafic file for the initial
conditions. You can download one easily by executing in the command line
the following script:
> utils/script/load_cosmo_ic.sh
To compile the code with MPI, type in the command line:
> make MPI=1 UNITS=cosmo CONDINIT=default HYDRO=1 GRAV=1 NVAR=7

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
nrestart=0
nsubcycle=1,1,2
ncontrol=1
verbose=.false.
/

&OUTPUT_PARAMS
delta_aout=0.1
aend=1.0
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='ics_ramses'
/

&AMR_PARAMS
levelmin=7
levelmax=15
ngridmax=2000000
npartmax=4000000
nexpand=1,
/

&POISSON_PARAMS
epsilon=1.d-4
fast_solver=.true.
/


&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=1
dual_energy=0.2
entropy=.true.
scheme='muscl'
riemann='hllc'
/

&COOLING_PARAMS
cooling=.true.
metal=.true.
haardt_madau=.true.
self_shielding=.true.
z_ave=0.001
z_reion=10
/

&REFINE_PARAMS
m_refine=10*8.,
interpol_var=1
interpol_type=0
/

