This namelist performs a cosmological simulation with dark matter and gas.
Gas cooling and star formation are included.
You need a grafic file for the initial conditions. You can download one easily
by executing in the command line the following script:
./utils/scripts/load_cosmo_ic.sh
To compile the code with MPI, type in the command line:
make NDIM=3 MPI=1 UNITS=COSMO HYDRO=1 GRAV=1 NPSCAL=2

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
nrestart=0
nsubcycle=1,1,2
ncontrol=1
verbose=.false.
/

&OUTPUT_PARAMS
delta_aout=0.1
aend=1.0
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='ics_ramses'
/

&AMR_PARAMS
levelmin=7
levelmax=15
ngridmax=2000000
npartmax=4000000
nexpand=1,
/

&POISSON_PARAMS
epsilon=1.d-4
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=1
riemann='hllc'
/

&COOLING_PARAMS
cooling=.true.
metal=.true.
haardt_madau=.true.
self_shielding=.true.
z_ave=0.001
z_reion=10
/

&STAR_PARAMS
star=.true.
nstarmax=2000000
n_star=0.1
eps_star=0.01
m_star=1
/

&REFINE_PARAMS
m_refine=10*8.,
interpol_var=1
interpol_type=0
/
