This namelist sets up a 2D turbulent velocity field using grafic ICs.
Compile using:
make NDIM=2 HYDRO=1

&RUN_PARAMS
 hydro=.true.
 ncontrol=1
 nrestart=0
 nremap=0
 nsubcycle=10*1
 verbose=.false.
 nstepmax=1000000
 nsuperoct=0
/

&AMR_PARAMS
 levelmin=6
 levelmax=9
 ngridtot=8000000
 ncachemax=30000
 nexpand=1
 boxlen=1.0
/

&INIT_PARAMS
 filetype='grafic'
 initfile(1)='/Users/moseley/ramses-development/mini-ramses-main/ics/ic_turb/ic_turb_6_2d'
/

&OUTPUT_PARAMS
 delta_tout=0.25
 tend=3.0
/

&HYDRO_PARAMS
 gamma=1.4
 courant_factor=0.8
 slope_type=2
 riemann='hlld'
 riemann2d='llf'
/

&REFINE_PARAMS
 interpol_var=0
 interpol_type=2
 err_grad_d=0.1
/


