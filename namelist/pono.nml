This is the RAMSES parameter file for the Ponomarenko test in Teyssier, Fromang and Dormy (2006).
make NDIM=3 MPI=1 HYDRO=1 MHD=1 INIT=PONO

&RUN_PARAMS
hydro=.true.
ncontrol=1
nsubcycle=4*1,2
verbose=.false.
/

&AMR_PARAMS
levelmin=5
levelmax=8
ngridmax=2000000
nexpand=1
boxlen=8.055
/

&INIT_PARAMS
/

&OUTPUT_PARAMS
delta_tout=2.0
tend=200.
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=2
riemann='upwind'
riemann2d='upwind'
induction=.true.
etamag=0.0025
/

&REFINE_PARAMS
err_grad_u=0.1
floor_u=1.0
interpol_var=0
interpol_type=2
/
