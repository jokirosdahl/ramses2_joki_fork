This is the RAMSES parameter file for the Brio & Wu (1988) MHD shock tube test.
Compile the code with:
make NDIM=1 HYDRO=1 MHD=1

&RUN_PARAMS
hydro=.true.
nsubcycle=4*1,
/

&AMR_PARAMS 
levelmin=3
levelmax=12
ngridmax=10000
nexpand=1
box_size=1.0
box_xmin=1
box_xmax=-1
/

&BOUNDARY_PARAMS
nbound=2
periodic=.false.
bound_dir=1,1
bound_type=2,2
bound_shift=1,-1
bound_xmin=0,-1
bound_xmax=1,0
/

&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='square'
x_center=0.25,0.75
length_x=0.5,0.5
d_region=1.0,0.125
u_region=0.0,0.0
v_region=0.0,0.0
w_region=0.0,0.0
p_region=1.0,0.1
A_ave=0.75
B_region=1.0,-1.0
C_region=0.0,0.0
/

&OUTPUT_PARAMS
noutput=1
tout=0.1
/

&HYDRO_PARAMS
gamma=2
courant_factor=0.8
slope_type=2
riemann='hlld'
/

&REFINE_PARAMS 
err_grad_d=0.01
err_grad_u=0.05
err_grad_p=0.05
interpol_var=0
interpol_type=2
/



