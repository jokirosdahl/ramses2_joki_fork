This namelist performs a cosmological zoom-in simulation with dark matter,
star formation and gas dynamics. You need zoom-in grafic files for the
initial conditions. You can generate such files using the MUSIC code.
You can also download an example from tigress using:
./utils/scripts/load_zoom_ic.sh
To compile the code with MPI, type in the command line:
make NDIM=3 MPI=1 UNITS=COSMO HYDRO=1 GRAV=1 NPSCAL=3

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
nrestart=0
nsubcycle=1,1,1,1,1,2
ncontrol=1
verbose=.false.
/

&OUTPUT_PARAMS
delta_aout=0.1
aend=1.0
/

&INIT_PARAMS
filetype='grafic_zoom'
initfile(1)='ics_zoom/level_007'
initfile(2)='ics_zoom/level_008'
initfile(3)='ics_zoom/level_009'
initfile(4)='ics_zoom/level_010'
/

&AMR_PARAMS
levelmin=7
levelmax=18
ngridmax=2000000
npartmax=4000000
nexpand=5,5,1,1
/

&POISSON_PARAMS
epsilon=1.d-4
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=1
riemann='hllc'
/

&COOLING_PARAMS
cooling=.true.
metal=.true.
haardt_madau=.true.
self_shielding=.true.
z_ave=0.001
z_reion=10
/

&STAR_PARAMS
star=.true.
nstarmax=2000000
n_star=0.1
eps_star=0.01
m_star=1
/

&REFINE_PARAMS
m_refine=12*8.,
interpol_var=1
interpol_type=0
ivar_refine=8
var_cut_refine=0.01
mass_cut_refine=2e-9
/
