This namelist contains input parameters for the 1D blastwave test.
Compile the code using:
make NDIM=1 HYDRO=1

&RUN_PARAMS 
hydro=.true.
nremap=10
ncontrol=10
nsubcycle=10*1
/

&AMR_PARAMS
levelmin=5
levelmax=11
ngridmax=2000
nexpand=1
box_size=1.0
box_xmin=1
box_xmax=-1
/

&BOUNDARY_PARAMS
nbound=2
periodic=.false.
bound_dir=1,1
bound_type=1,1
bound_shift=1,-1
bound_xmin=0,-1
bound_xmax=1,0
/

&INIT_PARAMS
nregion=3
region_type(1)='square'
region_type(2)='square'
region_type(3)='square'
x_center=0.05,0.5,0.95
length_x= 0.1,0.8,0.1
d_region= 1.0,1.0,1.0
u_region= 0.0,0.0,0.0
p_region=1.e3,0.01,1.e2
/

&OUTPUT_PARAMS
noutput=8
tout=0.006,0.016,0.026,0.028,0.030,0.032,0.034,0.038
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=2
riemann='hllc'
/

&REFINE_PARAMS 
err_grad_d=0.01
err_grad_u=0.01
err_grad_p=0.01
interpol_var=0
interpol_type=2
/

