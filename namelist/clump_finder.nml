This namelist will perform clump finding on a RAMSES output file.
To compile the code with MPI, type in the command line:
make NDIM=3 MPI=1 UNITS=COSMO HYDRO=0 GRAV=1

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
clump_only=.true.
verbose=.false.
/

&INIT_PARAMS
filetype='ramses'
initfile(1)='output_00041'
/

&OUTPUT_PARAMS
/

&AMR_PARAMS
levelmin=7
levelmax=20
ngridmax=2000000
npartmax=4000000
nexpand=2,2,2,1,1
/

&POISSON_PARAMS
epsilon=1.d-4
/

&REFINE_PARAMS
m_refine=13*8.,
mass_cut_refine=2e-10
/

&CLUMP_PARAMS
clump_finder=.true.
merger_tree=.true.
rho_type_clump=1
density_threshold=80
relevance_threshold=3
purity_threshold=0.98
saddle_threshold=200
mass_threshold=1.2e-9
output_clump=.true.
output_peak_grid=.true.
output_peak_part=.true.
/
